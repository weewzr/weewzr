---
/**
 * Sticky solid navigation bar.
 * - Links come from `nav` in site.ts and point at real pages through withBase().
 * - The current section is worked out at build time from the URL: aria-current="page" on the exact page,
 *   aria-current="true" (same highlight) when the page is inside that section.
 * - Below 860px the links move into a fade panel opened by a menu button.
 * - A colour-mode button (moon when light, sun when dark) sits beside the social icons; it is hidden without JavaScript.
 * - Without JavaScript the panel stays visible as a static block, so every link is reachable.
 */
import { site, nav, social } from '../data/site';
import { withBase } from '../lib/url';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const here = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname;
const current = `/${here.replace(/^\/+/, '')}`;
const items = nav.map((item) => {
  const prefix = `/${item.path}`;
  const exact = current === prefix;
  const inside = !exact && current.startsWith(prefix);
  return { ...item, state: (exact ? 'page' : inside ? 'true' : undefined) as 'page' | 'true' | undefined };
});
---

<header class="nav" data-site-nav>
  <div class="nav__bar container">
    <a class="nav__brand" href={withBase('')} aria-label={`${site.name}, home`} aria-current={current === '/' ? 'page' : undefined}>
      <svg class="nav__mark" width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
        <ellipse
          cx="16"
          cy="16"
          rx="14"
          ry="5.4"
          transform="rotate(-30 16 16)"
          stroke="currentColor"
          stroke-width="1.6"></ellipse>
        <path d="M16 5.5 18.1 13.9 26.5 16 18.1 18.1 16 26.5 13.9 18.1 5.5 16 13.9 13.9Z" fill="currentColor"></path>
      </svg>
      <span class="nav__name">{site.name}</span>
    </a>

    <button type="button" class="nav__toggle" aria-expanded="false" aria-controls="site-menu" aria-label="Menu">
      <span class="nav__toggle-open"><Icon name="menu" size={20} /></span>
      <span class="nav__toggle-close"><Icon name="close" size={20} /></span>
    </button>

    <nav class="nav__panel" id="site-menu" aria-label="Primary">
      <ul class="nav__links">
        {
          items.map((item) => (
            <li>
              <a class="nav__link" href={withBase(item.path)} aria-current={item.state}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav__social">
        <a
          class="nav__icon"
          href={social.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile, opens in a new tab"
        >
          <Icon name="github" size={20} />
        </a>
        <a
          class="nav__icon"
          href={social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile, opens in a new tab"
        >
          <Icon name="linkedin" size={20} />
        </a>
        <button type="button" class="nav__icon" data-theme-toggle aria-label="Switch to light theme">
          <span class="nav__theme-moon"><Icon name="moon" size={20} /></span>
          <span class="nav__theme-sun"><Icon name="sun" size={20} /></span>
        </button>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .nav__bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 100%;
  }

  /* Brand */
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    flex-shrink: 0;
    color: var(--text);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--fs-card-title);
    text-decoration: none;
  }
  .nav__name {
    white-space: nowrap;
  }
  .nav__mark {
    flex-shrink: 0;
    color: var(--accent);
  }

  /* Panel: inline row on desktop. */
  .nav__panel {
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
    justify-content: space-between;
    gap: var(--space-4);
    margin-left: var(--space-2);
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-3);
    color: var(--text-muted);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-small);
    text-decoration: none;
    transition: color var(--ease);
  }
  .nav__link:hover,
  .nav__link[aria-current] {
    color: var(--text);
  }
  .nav__link[aria-current]::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: 6px;
    height: 2px;
    background: var(--accent);
  }

  .nav__social {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-shrink: 0;
  }
  .nav__icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: var(--radius);
    color: var(--text-muted);
    background: none;
    border: 1px solid transparent;
    cursor: pointer;
    transition: color var(--ease), background-color var(--ease), border-color var(--ease);
  }
  .nav__icon:hover {
    color: var(--text);
    background-color: var(--bg-subtle);
  }

  /* Colour-mode icon: sun on the default night page, moon when the page is light. */
  .nav__theme-moon {
    display: none;
    place-items: center;
  }
  .nav__theme-sun {
    display: grid;
    place-items: center;
  }
  :global(:root[data-theme='light']) .nav__theme-moon {
    display: grid;
  }
  :global(:root[data-theme='light']) .nav__theme-sun {
    display: none;
  }
  :global(html:not(.js)) [data-theme-toggle] {
    display: none;
  }

  /* Menu button: hidden on desktop. */
  .nav__toggle {
    display: none;
    margin-left: auto;
    width: 44px;
    height: 44px;
    padding: 0;
    place-items: center;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition: background-color var(--ease), border-color var(--ease);
  }
  .nav__toggle:hover {
    background-color: var(--bg-subtle);
    border-color: var(--border-strong);
  }
  .nav__toggle-open,
  .nav__toggle-close {
    display: grid;
    place-items: center;
  }
  .nav__toggle-close {
    display: none;
  }
  .nav__toggle[aria-expanded='true'] .nav__toggle-open {
    display: none;
  }
  .nav__toggle[aria-expanded='true'] .nav__toggle-close {
    display: grid;
  }

  /* Mobile layout. */
  @media (max-width: 859.98px) {
    .nav__toggle {
      display: inline-grid;
    }
    .nav__panel {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex: none;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      margin: 0;
      padding: var(--space-1) var(--space-4) var(--space-4);
      max-height: calc(100svh - var(--nav-h));
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--surface);
      border: 1px solid var(--border);
      border-top: 0;
      box-shadow: var(--shadow-sm);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--ease),
        visibility 0s linear 150ms;
    }
    .nav__toggle[aria-expanded='true'] + .nav__panel {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }
    .nav__links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin: 0;
    }
    .nav__link {
      display: flex;
      min-height: 52px;
      padding: 0 var(--space-1);
      font-size: var(--fs-body);
      border-bottom: 1px solid var(--border);
    }
    .nav__link[aria-current]::after {
      left: var(--space-1);
      right: auto;
      bottom: 10px;
      width: var(--space-6);
    }
    .nav__social {
      padding-top: var(--space-3);
      gap: var(--space-2);
    }
    .nav__icon {
      border-color: var(--border);
    }
  }

  /* Narrow phones: tighten the brand so the bar never overflows at 360px. */
  @media (max-width: 380px) {
    .nav__brand {
      font-size: var(--fs-body);
    }
  }

  /* Without JavaScript the panel is a plain block under the bar and the header is not sticky. */
  @media (max-width: 859.98px) {
    :global(html:not(.js)) .nav {
      position: relative;
      height: auto;
    }
    :global(html:not(.js)) .nav__bar {
      flex-wrap: wrap;
      height: auto;
    }
    :global(html:not(.js)) .nav__brand {
      min-height: var(--nav-h);
    }
    :global(html:not(.js)) .nav__toggle {
      display: none;
    }
    :global(html:not(.js)) .nav__panel {
      position: static;
      flex: 1 0 100%;
      opacity: 1;
      visibility: visible;
      max-height: none;
      padding: 0 0 var(--space-4);
      background: none;
      box-shadow: none;
      border: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__panel {
      transition: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-nav]');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav__toggle');
  const panel = header?.querySelector<HTMLElement>('#site-menu');

  if (header && toggle && panel) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean, restoreFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (!open && restoreFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    // Escape closes the panel; focus returns to the button if it was inside the panel.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !isOpen()) return;
      setOpen(false, panel.contains(document.activeElement));
    });

    // A click outside the header closes the panel.
    document.addEventListener('pointerdown', (event) => {
      if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
    });

    // Following a link closes the panel.
    panel.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });

    // Tabbing out of the header closes the panel.
    header.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (isOpen() && next && !header.contains(next)) setOpen(false);
    });

    // Reset when the layout switches to the desktop bar.
    window.matchMedia('(min-width: 860px)').addEventListener('change', () => setOpen(false));
  }

  // Colour-mode toggle: night is the default; data-theme="light" on <html> switches to the white page.
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (themeButton) {
    const root = document.documentElement;
    const effective = () => (root.getAttribute('data-theme') === 'light' ? 'light' : 'dark');
    const sync = () => {
      themeButton.setAttribute('aria-label', effective() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
    };
    sync();
    themeButton.addEventListener('click', () => {
      const next = effective() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable: the choice lasts for this page only */
      }
      sync();
    });
  }
</script>
