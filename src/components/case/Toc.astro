---
/**
 * "On this page" list. Two renderings of the same links: a sticky list on wide screens and a <details>
 * above the prose on small screens. Only one is displayed at a time (the other is display: none, so it
 * is not in the accessibility tree). Scroll-spy marks the current link with aria-current as an enhancement.
 * Props: items ({ id, label }[]), label (default "On this page").
 */
interface Props {
  items: readonly { id: string; label: string }[];
  label?: string;
}
const { items, label = 'On this page' } = Astro.props;
---

{
  items.length > 0 && (
    <>
      <details class="toc-details glass" data-toc>
        <summary>{label}</summary>
        <nav aria-label={label}>
          <ol>
            {items.map((i) => (
              <li>
                <a href={`#${i.id}`} data-toc-link>{i.label}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
      <nav class="toc-side" aria-label={label} data-toc>
        <p class="toc-title" aria-hidden="true">{label}</p>
        <ol>
          {items.map((i) => (
            <li>
              <a href={`#${i.id}`} data-toc-link>{i.label}</a>
            </li>
          ))}
        </ol>
      </nav>
    </>
  )
}

<style>
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: block;
    padding: 0.5rem 0.75rem;
    min-height: 44px;
    border-left: 2px solid transparent;
    color: #cbd5e1;
    font-size: 0.93rem;
    line-height: 1.35;
    text-decoration: none;
  }
  a:hover {
    color: #fff;
    background: rgb(148 163 184 / 0.1);
  }
  a[aria-current='true'] {
    color: #fff;
    border-left-color: var(--lavender);
    background: rgb(124 58 237 / 0.16);
  }

  .toc-details {
    margin: 0 0 1.25rem;
    background: var(--glass-strong);
  }
  .toc-details summary {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 600;
    color: #fff;
  }
  .toc-details nav {
    padding: 0 0.5rem 0.6rem;
    border-top: 1px solid var(--line);
  }

  .toc-side {
    display: none;
  }
  @media (min-width: 1024px) {
    .toc-details {
      display: none;
    }
    .toc-side {
      display: block;
      position: sticky;
      top: calc(var(--nav-h) + 20px);
      max-height: calc(100vh - var(--nav-h) - 40px);
      overflow-y: auto;
      padding: 0.25rem 0;
    }
    .toc-title {
      margin: 0 0 0.5rem 0.75rem;
      font-family: var(--font-mono);
      font-size: 0.74rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--muted);
    }
  }
</style>

<script>
  import '../../scripts/case-toc.ts';
</script>
