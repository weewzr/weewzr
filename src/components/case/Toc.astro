---
/**
 * "On this page" list. Two renderings of the same links: a sticky list on wide screens and a <details>
 * above the prose on small screens. Only one is displayed at a time (the other is display: none, so it
 * is not in the accessibility tree). Scroll-spy marks the current link with aria-current as an enhancement.
 * Props: items ({ id, label }[]), label (default "On this page").
 */
interface Props {
  items: readonly { id: string; label: string }[];
  label?: string;
}
const { items, label = 'On this page' } = Astro.props;
---

{
  items.length > 0 && (
    <>
      <details class="toc-details glass" data-toc>
        <summary>{label}</summary>
        <nav aria-label={label}>
          <ol>
            {items.map((i) => (
              <li>
                <a href={`#${i.id}`} data-toc-link>{i.label}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
      <nav class="toc-side" aria-label={label} data-toc>
        <p class="toc-title" aria-hidden="true">{label}</p>
        <ol>
          {items.map((i) => (
            <li>
              <a href={`#${i.id}`} data-toc-link>{i.label}</a>
            </li>
          ))}
        </ol>
      </nav>
    </>
  )
}

<style>
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: block;
    padding: var(--space-2) var(--space-3);
    min-height: 44px;
    border-left: 2px solid transparent;
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: 1.35;
    text-decoration: none;
    transition:
      color var(--ease),
      background-color var(--ease),
      border-color var(--ease);
  }
  a:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }
  a[aria-current='true'] {
    color: var(--accent);
    font-weight: 600;
    border-left-color: var(--accent);
  }

  .toc-details {
    margin: 0 0 var(--space-4);
    background: var(--surface);
  }
  .toc-details summary {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    font-weight: 600;
    color: var(--text);
  }
  .toc-details nav {
    padding: 0 var(--space-2) var(--space-2);
    border-top: 1px solid var(--border);
  }

  .toc-side {
    display: none;
  }
  @media (min-width: 1024px) {
    .toc-details {
      display: none;
    }
    .toc-side {
      display: block;
      position: sticky;
      top: calc(var(--nav-h) + 20px);
      max-height: calc(100vh - var(--nav-h) - 40px);
      overflow-y: auto;
      padding: var(--space-1) 0;
    }
    .toc-title {
      margin: 0 0 var(--space-2) var(--space-3);
      font-size: var(--fs-small);
      font-weight: 600;
      color: var(--text-muted);
    }
  }
</style>


<script>
  import '../../scripts/case-toc.ts';
</script>
