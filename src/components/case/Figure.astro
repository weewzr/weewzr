---
/**
 * A figure for MDX bodies and the project pages.
 * Props: src (path under public/, no base), alt, caption (optional), width, height (real pixel size),
 * zoom (optional boolean: lets the reader open the image at full size in a dialog and pan by scrolling).
 * Without JavaScript a zoomable figure is a plain link to the full image.
 */
import { withBase } from '../../lib/url';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  width: number;
  height: number;
  zoom?: boolean;
}
const { src, alt, caption, width, height, zoom = false } = Astro.props;
const url = withBase(src);
---

<figure class="fig" data-figure>
  {
    zoom ? (
      <>
        <a
          class="fig-open"
          href={url}
          data-fig-open
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Enlarge image: ${alt} (opens the full-size image)`}
        >
          <img src={url} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
          <span class="fig-hint" aria-hidden="true">Enlarge</span>
        </a>
        <dialog class="fig-dialog" aria-label={`Full-size image: ${alt}`} data-fig-dialog>
          <div class="fig-dialog-bar">
            <p class="fig-dialog-cap">{caption ?? alt}</p>
            <button type="button" class="fig-close" data-fig-close>Close</button>
          </div>
          <div class="fig-dialog-scroll" tabindex="0" role="group" aria-label="Scrollable full-size image">
            <img src={url} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
          </div>
        </dialog>
      </>
    ) : (
      <img src={url} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig {
    margin: var(--space-5) 0;
  }
  .fig.fig img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-subtle);
  }
  .fig-open {
    display: block;
    border-radius: var(--radius);
    cursor: zoom-in;
    text-decoration: none;
  }
  /* The hint sits under the image, never on it, so it cannot cover an axis label or a value. */
  .fig-hint {
    display: block;
    width: fit-content;
    margin: var(--space-2) 0 0 auto;
    padding: 0.125rem var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--fs-label);
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border);
  }
  figcaption {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--text-muted);
    text-align: center;
  }

  .fig-dialog {
    width: min(96vw, 1200px);
    max-width: none;
    height: min(92vh, 900px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--text);
    overflow: hidden;
  }
  .fig-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .fig-dialog::backdrop {
    background: color-mix(in srgb, var(--navy) 85%, transparent);
  }
  .fig-dialog-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--border);
  }
  .fig-dialog-cap {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--text);
  }
  .fig-close {
    flex: none;
    min-height: 44px;
    min-width: 44px;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--ease),
      border-color var(--ease);
  }
  .fig-close:hover {
    border-color: var(--text);
    background: var(--bg-subtle);
  }
  .fig-dialog-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    padding: var(--space-3);
  }
  /* Full size: the image keeps its pixel width and the reader pans by scrolling. */
  .fig .fig-dialog-scroll img {
    max-width: none;
    width: auto;
    margin: 0;
    border: 0;
    border-radius: 0;
  }
</style>

<script>
  import '../../scripts/case-figure.ts';
</script>
