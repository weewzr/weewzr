---
/**
 * A figure for MDX bodies and the project pages.
 * Props: src (path under public/, no base), alt, caption (optional), width, height (real pixel size),
 * zoom (optional boolean: lets the reader open the image at full size in a dialog and pan by scrolling).
 * Without JavaScript a zoomable figure is a plain link to the full image.
 */
import { withBase } from '../../lib/url';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  width: number;
  height: number;
  zoom?: boolean;
}
const { src, alt, caption, width, height, zoom = false } = Astro.props;
const url = withBase(src);
---

<figure class="fig" data-figure>
  {
    zoom ? (
      <>
        <a
          class="fig-open"
          href={url}
          data-fig-open
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Enlarge image: ${alt} (opens the full-size image)`}
        >
          <img src={url} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
          <span class="fig-hint" aria-hidden="true">Enlarge</span>
        </a>
        <dialog class="fig-dialog" aria-label={`Full-size image: ${alt}`} data-fig-dialog>
          <div class="fig-dialog-bar">
            <p class="fig-dialog-cap">{caption ?? alt}</p>
            <button type="button" class="fig-close" data-fig-close>Close</button>
          </div>
          <div class="fig-dialog-scroll" tabindex="0" role="group" aria-label="Scrollable full-size image">
            <img src={url} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
          </div>
        </dialog>
      </>
    ) : (
      <img src={url} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig {
    margin: 1.75rem 0;
  }
  .fig.fig img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg-2);
  }
  .fig-open {
    display: block;
    border-radius: 12px;
    cursor: zoom-in;
    text-decoration: none;
  }
  /* The hint sits under the image, never on it, so it cannot cover an axis label or a value. */
  .fig-hint {
    display: block;
    width: fit-content;
    margin: 0.5rem 0 0 auto;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #fff;
    background: rgb(6 11 27 / 0.82);
    border: 1px solid rgb(167 139 250 / 0.5);
  }
  figcaption {
    margin-top: 0.55rem;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--muted);
    text-align: center;
  }

  .fig-dialog {
    width: min(96vw, 1200px);
    max-width: none;
    height: min(92vh, 900px);
    margin: auto;
    padding: 0;
    border: 1px solid rgb(167 139 250 / 0.5);
    border-radius: 14px;
    background: var(--bg);
    color: var(--text);
    overflow: hidden;
  }
  .fig-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .fig-dialog::backdrop {
    background: rgb(2 6 18 / 0.86);
  }
  .fig-dialog-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.75rem 0.5rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  .fig-dialog-cap {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--text);
  }
  .fig-close {
    flex: none;
    min-height: 44px;
    min-width: 44px;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.06);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    cursor: pointer;
  }
  .fig-close:hover {
    border-color: rgb(167 139 250 / 0.7);
    background: rgb(124 58 237 / 0.2);
  }
  .fig-dialog-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    padding: 0.75rem;
  }
  /* Full size: the image keeps its pixel width and the reader pans by scrolling. */
  .fig .fig-dialog-scroll img {
    max-width: none;
    width: auto;
    margin: 0;
    border: 0;
    border-radius: 0;
  }
</style>

<script>
  import '../../scripts/case-figure.ts';
</script>
