---
/**
 * Phased timeline, reused for the Grant A Wish phases and (through Roadmap.astro) the project roadmaps.
 * Props:
 *   items  Milestone[]  phases in order ({ id, title, period?, status, summary?, items[] })
 *   label  string       accessible name of the whole timeline, for example "Project timeline"
 *   noun   'phase' | 'step'  word used in the numbers and the progress text (default 'phase')
 * Semantics: an ordered list. Each phase shows its number, title, period, a status badge in words, the
 * summary and dated sub-items. Without JavaScript every phase is expanded in a vertical list. With
 * JavaScript, on wide screens a progress rail of buttons (WAI-ARIA disclosure, aria-expanded, arrow keys)
 * expands the matching phase. Progress is stated as text computed from the data, never as a percentage.
 */
import type { Milestone } from '../../lib/case';
import { milestoneStatusText, progressText, slugify } from '../../lib/case';

interface Props {
  items: readonly Milestone[];
  label: string;
  noun?: 'phase' | 'step';
}
const { items, label, noun = 'phase' } = Astro.props;
const Noun = `${noun[0].toUpperCase()}${noun.slice(1)}`;
const base = `tl-${slugify(label)}`;
const progress = progressText(items, noun);
const firstOpen = (() => {
  const active = items.findIndex((m) => m.status === 'active');
  if (active >= 0) return active;
  // Otherwise the most recent completed step, because that is the one with something to read.
  const lastDone = items.map((m) => m.status).lastIndexOf('done');
  return lastDone >= 0 ? lastDone : 0;
})();
---

{
  items.length > 0 && (
    <div class="tl" data-timeline data-first-open={firstOpen}>
      <p class="tl-progress">{progress}</p>

      <div class="tl-rail" data-tl-rail style={`--n:${items.length}`} role="group" aria-label={`${label}: choose a ${noun} to expand`}>
        {items.map((m, i) => (
          <button
            type="button"
            class={`tl-step st-${m.status}`}
            id={`${base}-btn-${m.id}`}
            aria-controls={`${base}-${m.id}`}
            aria-expanded="true"
            data-tl-btn
          >
            <span class="tl-dot" aria-hidden="true">{m.status === 'done' ? '✓' : i + 1}</span>
            <span class="tl-step-title">{m.title}</span>
            <span class="tl-step-status">{milestoneStatusText[m.status]}</span>
          </button>
        ))}
      </div>

      <ol class="tl-list" aria-label={label}>
        {items.map((m, i) => {
          const hasDetail = Boolean(m.summary) || m.items.length > 0;
          return (
            <li class={`tl-item st-${m.status}`} id={`${base}-${m.id}`} data-tl-panel>
              <div class="tl-head">
                <span class="tl-num">{Noun} {i + 1}</span>
                <h3>{m.title}</h3>
                <p class="tl-meta">
                  {m.period && <span class="tl-period">{m.period}</span>}
                  <span class={`tl-badge st-${m.status}`}>{milestoneStatusText[m.status]}</span>
                </p>
              </div>
              {m.summary && <p class="tl-summary">{m.summary}</p>}
              {!hasDetail && m.status === 'upcoming' && (
                <p class="tl-summary tl-neutral">Details will be added when confirmed.</p>
              )}
              {m.items.length > 0 && (
                <ul class="tl-sub">
                  {m.items.map((it) => (
                    <li>
                      {it.date && <span class="tl-date">{it.date}</span>}
                      <span class="tl-label">{it.label}</span>
                      {it.detail && <span class="tl-detail">{it.detail}</span>}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ol>
    </div>
  )
}

<style>
  .tl-progress {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* Rail: only with JavaScript, only on wide screens. */
  .tl-rail {
    display: none;
  }
  @media (min-width: 900px) {
    :global(.js) .tl-rail {
      display: grid;
      grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr));
      gap: var(--space-2);
      margin: 0 0 var(--space-5);
      position: relative;
    }
    :global(.js) .tl-rail::before {
      content: '';
      position: absolute;
      left: 8%;
      right: 8%;
      top: 1.5rem;
      height: 1px;
      background: var(--border);
    }
  }
  .tl-step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-2) var(--space-3);
    border: 0;
    border-bottom: 2px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    text-align: center;
    font: inherit;
    cursor: pointer;
    transition:
      color var(--ease),
      background-color var(--ease),
      border-color var(--ease);
  }
  .tl-step:hover {
    background: var(--bg-subtle);
  }
  .tl-step[aria-expanded='true'] {
    border-bottom-color: var(--accent);
    background: var(--bg-subtle);
  }
  .tl-step[aria-expanded='true'] .tl-step-title {
    color: var(--accent);
  }
  .tl-dot {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--text);
    background: var(--bg);
    border: 2px solid var(--border-strong);
    z-index: 1;
  }
  .st-done .tl-dot {
    background: var(--accent-solid);
    border-color: var(--accent-solid);
    color: var(--on-accent);
  }
  .st-active .tl-dot {
    background: var(--bg);
    border-color: var(--accent);
    color: var(--accent);
  }
  .tl-step-title {
    font-weight: 600;
    font-size: var(--fs-small);
    line-height: 1.25;
    color: var(--text);
  }
  .tl-step-status {
    font-size: var(--fs-label);
    color: var(--text-muted);
  }

  /* Phase list */
  .tl-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .tl-item {
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .tl-item.st-done {
    border-left-color: var(--accent);
  }
  .tl-item.st-active {
    border-left-color: var(--cyan);
  }
  .tl-item[hidden] {
    display: none;
  }
  .tl-num {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .tl-head h3 {
    margin-top: var(--space-1);
    font-size: var(--fs-card-title);
    font-weight: 600;
    color: var(--text);
  }
  .tl-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-2);
  }
  .tl-period {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .tl-badge {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--fs-label);
    border: 1px solid var(--border);
    color: var(--text);
  }
  .tl-badge.st-done {
    background: var(--accent-bg);
    border-color: var(--accent);
  }
  .tl-badge.st-active {
    background: var(--cyan-bg);
    border-color: var(--cyan);
  }
  .tl-badge.st-upcoming {
    background: var(--bg-subtle);
  }
  .tl-summary {
    margin-top: var(--space-3);
    color: var(--text);
    line-height: 1.65;
  }
  .tl-neutral {
    color: var(--text-muted);
    font-style: italic;
  }
  .tl-sub {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .tl-sub li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    padding-left: var(--space-3);
    border-left: 1px solid var(--border);
  }
  @media (min-width: 640px) {
    .tl-sub li {
      grid-template-columns: 9rem minmax(0, 1fr);
      column-gap: var(--space-4);
    }
    .tl-sub .tl-detail {
      grid-column: 2;
    }
  }
  .tl-date {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .tl-label {
    color: var(--text);
  }
  .tl-detail {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  @media print {
    .tl-rail {
      display: none !important;
    }
  }
</style>

<script>
  import '../../scripts/case-timeline.ts';
</script>
