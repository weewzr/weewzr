---
/**
 * Sources panel. Renders nothing when `sources` is empty.
 * Props: sources ({ label, url? }[]), heading (default "Sources"), id (heading id, default "case-sources").
 * An entry without a url is plain text marked "No public link": it is never rendered as a link.
 */
import Icon from '../Icon.astro';

interface Props {
  sources: readonly { label: string; url?: string | null }[];
  heading?: string;
  id?: string;
}
const { sources, heading = 'Sources', id = 'case-sources' } = Astro.props;
const shortUrl = (url: string) => {
  try {
    const u = new URL(url);
    return `${u.host}${u.pathname}`.replace(/\/$/, '');
  } catch {
    return url;
  }
};
---

{
  sources.length > 0 && (
    <section class="sources glass" aria-labelledby={id}>
      <h2 id={id}>{heading}</h2>
      <ul>
        {sources.map((s) => (
          <li>
            {s.url ? (
              <>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  <span class="src-label">{s.label}</span>
                  <span class="src-url">{shortUrl(s.url)}</span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
                <Icon name="external" size={16} />
              </>
            ) : (
              <p class="src-plain">
                <span class="src-name">{s.label}</span>
                <span class="src-url">No public link</span>
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .sources {
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3.5vw, 2.5rem);
    background: var(--glass-strong);
  }
  h2 {
    font-size: 1.25rem;
    font-weight: 600;
  }
  ul {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
  }
  li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--muted);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  li :global(svg) {
    flex: none;
  }
  a,
  .src-plain {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
    min-height: 44px;
    padding-block: 0.3rem;
    text-decoration: none;
    min-width: 0;
  }
  .src-label {
    color: #c4b5fd;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a:hover .src-label {
    color: #fff;
  }
  .src-name {
    color: var(--text);
  }
  .src-url {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
</style>
