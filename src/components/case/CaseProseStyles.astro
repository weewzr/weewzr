---
/**
 * Typography for rendered MDX case-study bodies. Include once per page that renders a .case-prose element.
 * MDX output carries no Astro scope attribute, so the rules are global, but every selector sits under .case-prose.
 */
---

<style is:global>
  /* Typography for the rendered MDX body. MDX output carries no Astro scope attribute, so these rules are
     global, but every selector sits under .case-prose. */
  .case-prose {
    max-width: 68ch;
    color: var(--text);
    font-size: var(--fs-body);
    line-height: 1.68;
    overflow-wrap: break-word;
  }
  .case-prose > :first-child {
    margin-top: 0;
  }
  .case-prose h2,
  .case-prose h3,
  .case-prose h4 {
    color: var(--text);
  }
  .case-prose h2 {
    font-family: var(--font-display);
    font-size: var(--fs-section-title);
    font-weight: 500;
    margin: var(--space-7) 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  .case-prose h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: var(--space-6) 0 var(--space-3);
  }
  .case-prose h4 {
    font-size: var(--fs-body);
    font-weight: 600;
    margin: var(--space-5) 0 var(--space-2);
  }
  .case-prose p {
    margin: 0 0 var(--space-4);
  }
  .case-prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .case-prose a:hover {
    color: var(--accent-hover);
  }
  .case-prose strong {
    font-weight: 600;
  }
  .case-prose ul,
  .case-prose ol {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
  }
  /* Tailwind's preflight removes list markers, so restore them here. */
  .case-prose ul {
    list-style: disc;
  }
  .case-prose ul ul {
    list-style: circle;
  }
  .case-prose ol {
    list-style: decimal;
  }
  .case-prose li {
    margin: var(--space-1) 0;
    padding-left: var(--space-1);
  }
  .case-prose li > ul,
  .case-prose li > ol {
    margin: var(--space-1) 0;
  }
  .case-prose ul li::marker {
    color: var(--text-muted);
  }
  .case-prose ol li::marker {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .case-prose blockquote {
    margin: var(--space-5) 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
  }
  .case-prose blockquote > :last-child {
    margin-bottom: 0;
  }
  .case-prose hr {
    border: 0;
    height: 1px;
    margin: var(--space-6) 0;
    background: var(--border);
  }
  .case-prose code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.12em 0.4em;
    border-radius: var(--radius-sm);
    background: var(--bg-subtle);
    color: var(--text);
  }
  /* Astro highlights fenced code with a dark theme and inline colours. Those colours would be unreadable on
     the light surface, so code blocks use the page tokens instead. */
  .case-prose pre {
    margin: var(--space-5) 0;
    padding: var(--space-4);
    overflow-x: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-subtle) !important;
    color: var(--text) !important;
    font-size: 0.9em;
    line-height: 1.6;
  }
  .case-prose pre span {
    color: inherit !important;
  }
  .case-prose pre code {
    padding: 0;
    background: none;
    border-radius: 0;
    font-size: inherit;
    color: inherit;
  }
  .case-prose img,
  .case-prose video {
    display: block;
    max-width: 100%;
    height: auto;
    margin: var(--space-5) auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .case-prose figure {
    margin: var(--space-5) 0;
  }
  .case-prose figcaption {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    color: var(--text-muted);
    text-align: center;
  }
  /* Tables scroll sideways inside their own box on narrow screens. */
  .case-prose .table-scroll {
    margin: var(--space-5) 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) var(--bg-subtle);
    padding-bottom: var(--space-1);
  }
  .case-prose table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .case-prose th,
  .case-prose td {
    padding: var(--space-2) var(--space-3);
    border: 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .case-prose th {
    background: var(--bg-subtle);
    color: var(--text);
    font-weight: 600;
    white-space: nowrap;
  }
  .case-prose kbd {
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    font-size: 0.9em;
  }
</style>
