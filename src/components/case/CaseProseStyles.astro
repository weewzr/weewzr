---
/**
 * Typography for rendered MDX case-study bodies. Include once per page that renders a .case-prose element.
 * MDX output carries no Astro scope attribute, so the rules are global, but every selector sits under .case-prose.
 */
---

<style is:global>
  /* Typography for the rendered MDX body. MDX output carries no Astro scope attribute, so these rules are
     global, but every selector sits under .case-prose. */
  .case-prose {
    color: #d5deea;
    font-size: 1.04rem;
    line-height: 1.75;
    overflow-wrap: break-word;
  }
  .case-prose > :first-child {
    margin-top: 0;
  }
  .case-prose h2,
  .case-prose h3,
  .case-prose h4 {
    color: #fff;
  }
  .case-prose h2 {
    font-size: clamp(1.45rem, 3vw, 1.85rem);
    font-weight: 600;
    margin: 2.6rem 0 1rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--line);
  }
  .case-prose h3 {
    font-size: clamp(1.15rem, 2.2vw, 1.35rem);
    font-weight: 600;
    margin: 2rem 0 0.7rem;
  }
  .case-prose h4 {
    font-size: 1.02rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
    color: #e2e8f0;
  }
  .case-prose p {
    margin: 0 0 1.05rem;
  }
  .case-prose a {
    color: #c4b5fd;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .case-prose a:hover {
    color: #fff;
  }
  .case-prose strong {
    color: #fff;
    font-weight: 600;
  }
  .case-prose ul,
  .case-prose ol {
    margin: 0 0 1.15rem;
    padding-left: 1.5rem;
  }
  /* Tailwind's preflight removes list markers, so restore them here. */
  .case-prose ul {
    list-style: disc;
  }
  .case-prose ul ul {
    list-style: circle;
  }
  .case-prose ol {
    list-style: decimal;
  }
  .case-prose li {
    margin: 0.35rem 0;
    padding-left: 0.2rem;
  }
  .case-prose li > ul,
  .case-prose li > ol {
    margin: 0.3rem 0 0.3rem;
  }
  .case-prose ul li::marker {
    color: var(--lavender);
  }
  .case-prose ol li::marker {
    color: var(--lavender);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .case-prose blockquote {
    margin: 1.5rem 0;
    padding: 0.8rem 1.2rem;
    border-left: 3px solid var(--purple);
    border-radius: 0 12px 12px 0;
    background: rgb(124 58 237 / 0.1);
    color: #e2e8f0;
  }
  .case-prose blockquote > :last-child {
    margin-bottom: 0;
  }
  .case-prose hr {
    border: 0;
    height: 1px;
    margin: 2.25rem 0;
    background: var(--line);
  }
  .case-prose code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    padding: 0.12em 0.4em;
    border-radius: 6px;
    background: rgb(148 163 184 / 0.15);
    color: #e0e7ff;
  }
  .case-prose pre {
    margin: 1.4rem 0;
    padding: 1rem 1.15rem;
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgb(6 11 27 / 0.9) !important;
    font-size: 0.86rem;
    line-height: 1.6;
  }
  .case-prose pre code {
    padding: 0;
    background: none;
    border-radius: 0;
    font-size: inherit;
    color: inherit;
  }
  .case-prose img,
  .case-prose video {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.5rem auto;
    border-radius: 12px;
    border: 1px solid var(--line);
  }
  .case-prose figure {
    margin: 1.5rem 0;
  }
  .case-prose figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    text-align: center;
  }
  /* Tables scroll sideways inside their own box on narrow screens. */
  .case-prose .table-scroll {
    margin: 1.5rem 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: 6px;
    /* A thin coloured scrollbar shows that a wide table scrolls sideways. */
    scrollbar-width: thin;
    scrollbar-color: rgb(167 139 250 / 0.7) rgb(148 163 184 / 0.12);
    padding-bottom: 0.35rem;
  }
  .case-prose table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .case-prose th,
  .case-prose td {
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .case-prose th {
    background: rgb(59 130 246 / 0.14);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    white-space: nowrap;
  }
  .case-prose tbody tr:nth-child(even) td {
    background: rgb(255 255 255 / 0.025);
  }
  .case-prose kbd {
    padding: 0.1em 0.4em;
    border-radius: 5px;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.06);
    font-size: 0.85em;
  }
</style>
