---
/**
 * Research easter egg: a compact "classified" console. Static block, rendered after the research cards.
 * Progressive enhancement: without JavaScript the panel is simply shown open. With JavaScript it is
 * collapsed until the trigger button is activated (click, Enter or Space). Escape closes it and returns focus.
 */
import { mascot } from '../data/site';
import PerryImage from './PerryImage.astro';
import Icon from './Icon.astro';

const enabled = mascot.enabled;
const triggerLabel = enabled ? `Open ${mascot.alias} research console` : 'Open research console';

/** One-line, neutral descriptions of each field. They describe the field only. */
const fieldNotes: Record<string, string> = {
  'Nuclear engineering':
    'The science of producing and controlling energy from fission, from reactor physics to fuel behaviour.',
  'Hydrogen technologies':
    'Producing and storing hydrogen so it can serve as a low-carbon fuel or an industrial feedstock.',
  'Scientific computing':
    'Numerical methods and software for solving mathematical models of physical and chemical systems.',
  'Process optimisation':
    'Tuning operating conditions and design choices so a process meets its targets at lower cost and energy use.',
};

const items = mascot.researchConsolePanel.map((name, i) => ({
  name,
  note: fieldNotes[name] ?? '',
  index: String(i + 1).padStart(2, '0'),
}));
---

<div class="perry-console" data-perry-console>
  <div class="perry-console__shell">
    <span class="perry-console__tape" aria-hidden="true"></span>

    <button
      type="button"
      class="perry-console__trigger"
      aria-expanded="false"
      aria-controls="perry-console-panel"
      aria-describedby="perry-console-line"
      aria-label={triggerLabel}
    >
      <span class="perry-console__avatar">
        <PerryImage slot="research" class="perry-console__img" />
      </span>
      <span class="perry-console__text">
        <span class="perry-console__prompt" aria-hidden="true">
          &gt; ./research --classified<i class="perry-console__cursor"></i>
        </span>
        <span class="perry-console__line" id="perry-console-line">{mascot.lines.research}</span>
      </span>
      <span class="perry-console__chev" aria-hidden="true"></span>
    </button>

    <div class="perry-console__reveal" id="perry-console-panel" role="group" aria-label="Research areas">
      <div class="perry-console__panel">
        <span class="perry-console__scan" aria-hidden="true"></span>
        <div class="perry-console__inner">
          <div class="perry-console__head">
            <p class="perry-console__file">Dossier: research areas</p>
            <span class="perry-console__stamp" aria-hidden="true">Classified</span>
          </div>
          <ul class="perry-console__list" role="list">
            {
              items.map((item, i) => (
                <li class="perry-console__item" style={`--i:${i}`}>
                  <span class="perry-console__idx" aria-hidden="true">
                    {item.index}
                  </span>
                  <span class="perry-console__name">{item.name}</span>
                  {item.note && <span class="perry-console__note">{item.note}</span>}
                </li>
              ))
            }
          </ul>
          <button type="button" class="btn perry-console__close">
            <Icon name="close" size={18} />
            Close console
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .perry-console {
    width: min(100%, 46rem);
    margin: clamp(1.75rem, 4vw, 3rem) auto 0;
  }
  .perry-console__shell {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px dashed rgb(167 139 250 / 0.45);
    background:
      repeating-linear-gradient(0deg, rgb(255 255 255 / 0.022) 0 1px, transparent 1px 3px),
      linear-gradient(160deg, rgb(11 27 58 / 0.78), rgb(8 14 36 / 0.9));
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: 0 18px 50px -28px rgb(124 58 237 / 0.55);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .perry-console__shell:hover,
  .perry-console__shell:focus-within,
  .perry-console.is-open .perry-console__shell {
    border-color: rgb(167 139 250 / 0.8);
    box-shadow: 0 22px 56px -26px rgb(124 58 237 / 0.75);
  }
  /* Caution tape along the top edge. */
  .perry-console__tape {
    display: block;
    height: 6px;
    background: repeating-linear-gradient(-45deg, rgb(124 58 237 / 0.6) 0 10px, rgb(6 11 27 / 0.95) 10px 20px);
    opacity: 0.8;
  }

  /* Trigger row */
  .perry-console__trigger {
    appearance: none;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    min-height: 44px;
    margin: 0;
    padding: 0.95rem 1.15rem;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .perry-console__trigger:focus-visible {
    outline: 2px solid var(--lavender);
    outline-offset: -4px;
    border-radius: var(--radius);
  }
  .perry-console__avatar {
    flex: none;
    display: block;
    width: 72px;
    height: 72px;
    padding: 3px;
    border-radius: 50%;
    background: var(--grad);
    box-shadow: 0 0 26px -6px rgb(124 58 237 / 0.7);
  }
  .perry-console__avatar :global(.perry-console__img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: 58% 40%;
    background: #0b1b3a;
  }
  .perry-console__avatar :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .perry-console__text {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    flex: 1;
  }
  .perry-console__prompt {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--lavender);
    overflow-wrap: anywhere;
  }
  .perry-console__cursor {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.3em;
    vertical-align: -0.14em;
    background: var(--lavender);
  }
  .perry-console__line {
    color: var(--text);
    font-size: 0.98rem;
    line-height: 1.45;
  }
  .perry-console__chev {
    flex: none;
    width: 10px;
    height: 10px;
    margin-right: 0.35rem;
    border-right: 2px solid var(--lavender);
    border-bottom: 2px solid var(--lavender);
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.3s ease;
  }
  .perry-console.is-open .perry-console__chev {
    transform: rotate(-135deg) translateY(-2px);
  }

  /* Reveal: height animates through grid rows; closed content is also visibility:hidden. */
  .perry-console__reveal {
    display: grid;
    grid-template-rows: 1fr;
  }
  .perry-console__panel {
    position: relative;
    min-height: 0;
    overflow: hidden;
    border-top: 1px dashed rgb(167 139 250 / 0.3);
  }
  :global(.js) .perry-console:not(.is-open) .perry-console__reveal {
    grid-template-rows: 0fr;
    visibility: hidden;
  }
  :global(.js) .perry-console:not(.is-open) .perry-console__panel {
    border-top-color: transparent;
  }
  .perry-console__inner {
    padding: 1.15rem 1.25rem 1.3rem;
  }
  .perry-console__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 1rem;
  }
  .perry-console__file {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .perry-console__stamp {
    display: inline-block;
    padding: 0.32rem 0.6rem 0.32rem 0.85rem;
    border: 2px solid currentColor;
    border-radius: 4px;
    outline: 1px solid rgb(253 164 175 / 0.4);
    outline-offset: 3px;
    color: #fda4af;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    line-height: 1;
    transform: rotate(-6deg);
    opacity: 0.92;
  }
  .perry-console__list {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 1.15rem;
    padding: 0;
    list-style: none;
  }
  .perry-console__item {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    column-gap: 0.5rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: rgb(6 11 27 / 0.45);
  }
  .perry-console__idx {
    grid-row: 1 / span 2;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--lavender);
    padding-top: 0.2rem;
  }
  .perry-console__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    color: var(--text);
  }
  .perry-console__note {
    grid-column: 2;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .perry-console__close {
    min-height: 44px;
    padding: 0.6rem 1.1rem;
    font-size: 0.9rem;
  }
  .perry-console__scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgb(196 181 253 / 0.95), transparent);
    box-shadow: 0 0 16px 3px rgb(124 58 237 / 0.55);
    opacity: 0;
  }

  /* No JavaScript: the panel stays open and the button has nothing to do. */
  :global(html:not(.js)) .perry-console__trigger {
    cursor: default;
    pointer-events: none;
  }
  :global(html:not(.js)) .perry-console__chev,
  :global(html:not(.js)) .perry-console__close,
  :global(html:not(.js)) .perry-console__cursor {
    display: none;
  }

  @media (max-width: 479px) {
    .perry-console__avatar {
      width: 60px;
      height: 60px;
    }
    .perry-console__trigger {
      gap: 0.8rem;
      padding-inline: 0.9rem;
    }
    .perry-console__inner {
      padding-inline: 0.9rem;
    }
    .perry-console__item {
      grid-template-columns: 1.9rem 1fr;
      padding-inline: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .perry-console__cursor {
      animation: perry-blink 1.1s steps(1) infinite;
    }
    .perry-console__reveal {
      transition: grid-template-rows 0.4s ease, visibility 0s linear 0.4s;
    }
    .perry-console.is-open .perry-console__reveal {
      transition-delay: 0s;
    }
    .perry-console.is-open .perry-console__scan {
      opacity: 1;
      animation: perry-scan 3.2s ease-in-out 0.2s infinite;
    }
    .perry-console.is-open .perry-console__item {
      animation: perry-console-in 0.45s ease both;
      animation-delay: calc(0.12s + var(--i, 0) * 90ms);
    }
    .perry-console.is-open .perry-console__stamp {
      animation: perry-stamp 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.2) 0.1s both;
    }
  }

  @keyframes perry-blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes perry-scan {
    0% {
      top: 0;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      top: calc(100% - 2px);
      opacity: 0;
    }
  }
  @keyframes perry-console-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes perry-stamp {
    from {
      opacity: 0;
      transform: rotate(-6deg) scale(1.7);
    }
  }
</style>

<script>
  // Disclosure behaviour for the research console. Escape closes it and returns focus to the trigger.
  document.querySelectorAll<HTMLElement>('[data-perry-console]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('.perry-console__trigger');
    const close = root.querySelector<HTMLButtonElement>('.perry-console__close');
    const region = root.querySelector<HTMLElement>('.perry-console__reveal');
    if (!trigger || !region) return;

    const setOpen = (open: boolean) => {
      root.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', String(open));
      region.inert = !open;
    };

    setOpen(false);
    trigger.addEventListener('click', () => setOpen(!root.classList.contains('is-open')));
    close?.addEventListener('click', () => {
      setOpen(false);
      trigger.focus();
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) {
        setOpen(false);
        trigger.focus();
      }
    });
  });
</script>
