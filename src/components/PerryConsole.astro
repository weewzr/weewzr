---
/**
 * Research easter egg: a compact "classified" console. Static block, rendered after the research cards.
 * Progressive enhancement: without JavaScript the panel is simply shown open. With JavaScript it is
 * collapsed until the trigger button is activated (click, Enter or Space). Escape closes it and returns focus.
 */
import { mascot } from '../data/site';
import PerryImage from './PerryImage.astro';
import Icon from './Icon.astro';

const enabled = mascot.enabled;

/** One-line, neutral descriptions of each field. They describe the field only. */
const fieldNotes: Record<string, string> = {
  'Nuclear engineering':
    'The science of producing and controlling energy from fission, from reactor physics to fuel behaviour.',
  'Hydrogen technologies':
    'Producing and storing hydrogen so it can serve as a low-carbon fuel or an industrial feedstock.',
  'Scientific computing':
    'Numerical methods and software for solving mathematical models of physical and chemical systems.',
  'Process optimisation':
    'Tuning operating conditions and design choices so a process meets its targets at lower cost and energy use.',
};

const items = mascot.researchConsolePanel.map((name, i) => ({
  name,
  note: fieldNotes[name] ?? '',
  index: String(i + 1).padStart(2, '0'),
}));
---

<div class="perry-console" data-perry-console>
  <div class="perry-console__shell">
    <span class="perry-console__tape" aria-hidden="true"></span>

    <button
      type="button"
      class="perry-console__trigger"
      aria-expanded="false"
      aria-controls="perry-console-panel"
    >
      <span class="perry-console__avatar">
        <PerryImage slot="research" class="perry-console__img" alt="" />
      </span>
      <span class="perry-console__text">
        <span class="perry-console__prompt" aria-hidden="true">
          &gt; ./research --classified<i class="perry-console__cursor"></i>
        </span>
        <span class="perry-console__line" id="perry-console-line">{mascot.lines.research}</span>
      </span>
      <span class="perry-console__chev" aria-hidden="true"></span>
    </button>

    <div class="perry-console__reveal" id="perry-console-panel" role="group" aria-label="Research areas">
      <div class="perry-console__panel">
        <div class="perry-console__inner">
          <div class="perry-console__head">
            <p class="perry-console__file">Dossier: research areas</p>
            <span class="perry-console__stamp" aria-hidden="true">Classified</span>
          </div>
          <ul class="perry-console__list" role="list">
            {
              items.map((item, i) => (
                <li class="perry-console__item" style={`--i:${i}`}>
                  <span class="perry-console__idx" aria-hidden="true">
                    {item.index}
                  </span>
                  <span class="perry-console__name">{item.name}</span>
                  {item.note && <span class="perry-console__note">{item.note}</span>}
                </li>
              ))
            }
          </ul>
          <button type="button" class="btn perry-console__close">
            <Icon name="close" size={16} />
            Close console
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Terminal-style panel: it stays dark in both colour modes on purpose, so it carries its own fixed colours. */
  .perry-console {
    --pc-bg: #0b1f3a;
    --pc-text: #e7edf4;
    --pc-muted: #a3b2c5;
    --pc-accent: #78aeff;
    --pc-border: #263750;
    width: min(100%, 46rem);
    margin: var(--space-7) auto 0;
  }
  .perry-console__shell {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--pc-border);
    background: var(--pc-bg);
    color: var(--pc-text);
    transition: border-color var(--ease);
  }
  .perry-console__shell:hover,
  .perry-console__shell:focus-within,
  .perry-console.is-open .perry-console__shell {
    border-color: var(--pc-accent);
  }
  /* A low-contrast accent stripe along the top edge. */
  .perry-console__tape {
    display: block;
    height: 4px;
    background: var(--pc-accent);
    opacity: 0.35;
  }

  /* Trigger row */
  .perry-console__trigger {
    appearance: none;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    min-height: 44px;
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .perry-console__trigger:focus-visible,
  .perry-console__close:focus-visible {
    outline: 2px solid var(--pc-accent);
    outline-offset: -4px;
    border-radius: var(--radius);
  }
  .perry-console__avatar {
    flex: none;
    display: block;
    width: 72px;
    height: 72px;
    border-radius: 50%; /* avatar */
    border: 1px solid var(--pc-border);
    overflow: hidden;
  }
  .perry-console__avatar :global(.perry-console__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 40%;
    background: var(--pc-bg);
  }
  .perry-console__avatar :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .perry-console__text {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
    flex: 1;
  }
  .perry-console__prompt {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--pc-accent);
    overflow-wrap: anywhere;
  }
  /* Static cursor, it does not blink. */
  .perry-console__cursor {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.3em;
    vertical-align: -0.14em;
    background: var(--pc-accent);
  }
  .perry-console__line {
    color: var(--pc-text);
    font-size: var(--fs-body);
    line-height: 1.45;
  }
  .perry-console__chev {
    flex: none;
    width: 10px;
    height: 10px;
    margin-right: var(--space-1);
    border-right: 2px solid var(--pc-accent);
    border-bottom: 2px solid var(--pc-accent);
    transform: rotate(45deg) translateY(-2px);
  }
  .perry-console.is-open .perry-console__chev {
    transform: rotate(-135deg) translateY(-2px);
  }

  /* Reveal: height animates through grid rows; closed content is also visibility:hidden. */
  .perry-console__reveal {
    display: grid;
    grid-template-rows: 1fr;
  }
  .perry-console__panel {
    position: relative;
    min-height: 0;
    overflow: hidden;
    border-top: 1px solid var(--pc-border);
  }
  :global(.js) .perry-console:not(.is-open) .perry-console__reveal {
    grid-template-rows: 0fr;
    visibility: hidden;
  }
  :global(.js) .perry-console:not(.is-open) .perry-console__panel {
    border-top-color: transparent;
  }
  .perry-console__inner {
    padding: var(--space-4) var(--space-5) var(--space-5);
  }
  .perry-console__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
  }
  .perry-console__file {
    margin: 0;
    font-size: var(--fs-label);
    color: var(--pc-muted);
  }
  .perry-console__stamp {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--pc-accent);
    border-radius: var(--radius-sm);
    color: var(--pc-accent);
    font-size: var(--fs-label);
    font-weight: 600;
    line-height: 1.2;
  }
  .perry-console__list {
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }
  .perry-console__item {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    column-gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--pc-border);
    border-radius: var(--radius);
  }
  .perry-console__idx {
    grid-row: 1 / span 2;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--pc-accent);
    padding-top: 0.2rem;
  }
  .perry-console__name {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--fs-body);
    color: var(--pc-text);
  }
  .perry-console__note {
    grid-column: 2;
    color: var(--pc-muted);
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  /* The shared .btn is restyled with the fixed console colours so it reads on the dark panel. */
  .perry-console__close {
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    font-size: var(--fs-small);
    background: transparent;
    color: var(--pc-text);
    border: 1px solid var(--pc-border);
    border-radius: var(--radius);
  }
  .perry-console__close:hover {
    background: transparent;
    color: var(--pc-text);
    border-color: var(--pc-accent);
  }

  /* No JavaScript: the panel stays open and the button has nothing to do. */
  :global(html:not(.js)) .perry-console__trigger {
    cursor: default;
    pointer-events: none;
  }
  :global(html:not(.js)) .perry-console__chev,
  :global(html:not(.js)) .perry-console__close {
    display: none;
  }

  @media (max-width: 479px) {
    .perry-console__avatar {
      width: 60px;
      height: 60px;
    }
    .perry-console__trigger {
      gap: var(--space-3);
      padding-inline: var(--space-4);
    }
    .perry-console__inner {
      padding-inline: var(--space-4);
    }
    .perry-console__item {
      grid-template-columns: 1.9rem 1fr;
      padding-inline: var(--space-3);
    }
  }

  /* The panel opens and closes in 300ms or less. Nothing loops. */
  @media (prefers-reduced-motion: no-preference) {
    .perry-console__chev {
      transition: transform 200ms ease;
    }
    .perry-console__reveal {
      transition: grid-template-rows 300ms ease, visibility 0s linear 300ms;
    }
    .perry-console.is-open .perry-console__reveal {
      transition-delay: 0s;
    }
  }
</style>

<script>
  // Disclosure behaviour for the research console. Escape closes it and returns focus to the trigger.
  document.querySelectorAll<HTMLElement>('[data-perry-console]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('.perry-console__trigger');
    const close = root.querySelector<HTMLButtonElement>('.perry-console__close');
    const region = root.querySelector<HTMLElement>('.perry-console__reveal');
    if (!trigger || !region) return;

    const setOpen = (open: boolean) => {
      root.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', String(open));
      region.inert = !open;
    };

    setOpen(false);
    trigger.addEventListener('click', () => setOpen(!root.classList.contains('is-open')));
    close?.addEventListener('click', () => {
      setOpen(false);
      trigger.focus();
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) {
        setOpen(false);
        trigger.focus();
      }
    });
  });
</script>
