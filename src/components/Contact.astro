---
import Icon from './Icon.astro';
import { social } from '../data/site';
import { withBase } from '../lib/url';

/**
 * Props:
 *   variant  'panel' (About page: heading, lead and a column of links) or 'strip' (home page: one compact row
 *            with a link to the About page)
 *   id       section id; both pages keep "contact" so old links still land here
 *   level    heading element ('h2' under a page h1)
 */
interface Props {
  variant?: 'panel' | 'strip';
  id?: string;
  level?: 'h2' | 'h3';
}
const { variant = 'panel', id = 'contact', level = 'h2' } = Astro.props;
const Heading = level;
const strip = variant === 'strip';

/** Readable form of a URL: no scheme, no www, no trailing slash. */
const shortUrl = (url: string) => {
  const u = new URL(url);
  return `${u.host.replace(/^www\./, '')}${u.pathname}`.replace(/\/+$/, '');
};

const links = [
  { label: 'GitHub', href: social.github, icon: 'github' },
  { label: 'LinkedIn', href: social.linkedin, icon: 'linkedin' },
]
  .filter((link) => link.href)
  .map((link) => ({ ...link, text: shortUrl(link.href) }));

// Email: split at build time, assembled in the browser, with a plain-text fallback for no-JS readers.
const email: string = social.email;
const [emailUser = '', emailDomain = ''] = email.split('@');
const emailFallback = email ? email.replace('@', ' [at] ').replace(/\./g, ' [dot] ') : '';
---

<section id={id} class:list={[strip ? 'block' : 'section', { 'is-strip': strip }]} aria-labelledby={`${id}-title`}>
  <div class="ct-wrap">
    <div class="ct-panel glass gradient-border">
      <div class="ct-copy reveal">
        <p class="eyebrow">Get in touch</p>
        <Heading id={`${id}-title`} class="section-title">Contact</Heading>
        <p class="section-lead">
          I welcome questions about the projects and research topics on this site. The links here are the quickest way to reach me.
        </p>
        {
          strip && (
            <a class="link-arrow ct-more" href={withBase('about/')}>
              More about me
              <Icon name="arrow-right" size={18} />
            </a>
          )
        }
      </div>

      <ul class="ct-list" role="list" aria-label="Contact links">
        {
          links.map((link, i) => (
            <li class="reveal" style={`--i:${i + 1}`}>
              <a class="ct-link" href={link.href} target="_blank" rel="noopener noreferrer">
                <span class="ct-ico">
                  <Icon name={link.icon} size={22} />
                </span>
                <span class="ct-text">
                  <span class="ct-label">{link.label}</span>
                  <span class="ct-value">{link.text}</span>
                </span>
                <Icon name="external" size={18} class="ct-go" />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))
        }
        {
          email && (
            <li class="reveal" style={`--i:${links.length + 1}`}>
              <a class="ct-link" data-email data-user={emailUser} data-domain={emailDomain} hidden>
                <span class="ct-ico">
                  <Icon name="mail" size={22} />
                </span>
                <span class="ct-text">
                  <span class="ct-label">Email</span>
                  <span class="ct-value" data-email-text />
                </span>
                <Icon name="arrow-right" size={18} class="ct-go" />
              </a>
              <noscript>
                <div class="ct-link ct-static">
                  <span class="ct-ico">
                    <Icon name="mail" size={22} />
                  </span>
                  <span class="ct-text">
                    <span class="ct-label">Email</span>
                    <span class="ct-value">{emailFallback}</span>
                  </span>
                </div>
              </noscript>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</section>

<script>
  function assembleEmail() {
    document.querySelectorAll<HTMLAnchorElement>('a[data-email]').forEach((anchor) => {
      const user = anchor.dataset.user;
      const domain = anchor.dataset.domain;
      if (!user || !domain) return;
      const address = user + '@' + domain;
      anchor.href = 'mailto:' + address;
      const out = anchor.querySelector('[data-email-text]');
      if (out) out.textContent = address;
      anchor.hidden = false;
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', assembleEmail);
  } else {
    assembleEmail();
  }
</script>

<style>
  .ct-wrap {
    width: min(100% - 2rem, var(--maxw));
    max-width: var(--maxw);
    margin-inline: auto;
  }
  .ct-panel {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border-radius: calc(var(--radius) + 6px);
    background:
      radial-gradient(70% 90% at 8% 0%, rgb(59 130 246 / 0.2), transparent 60%),
      radial-gradient(70% 100% at 100% 100%, rgb(124 58 237 / 0.26), transparent 60%),
      var(--glass-strong);
    box-shadow: 0 30px 80px -40px rgb(79 70 229 / 0.55);
  }
  @media (min-width: 900px) {
    .ct-panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      align-items: center;
    }
  }
  .ct-copy {
    min-width: 0;
  }

  .ct-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }
  .ct-list > li {
    min-width: 0;
  }

  .ct-link {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 3.75rem;
    padding: 0.65rem 0.9rem;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: rgb(6 11 27 / 0.45);
    color: var(--text);
    text-decoration: none;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease,
      box-shadow 0.25s ease;
  }
  .ct-link[hidden] {
    display: none;
  }
  a.ct-link:hover {
    color: #fff;
    border-color: rgb(167 139 250 / 0.6);
    background: rgb(124 58 237 / 0.16);
    box-shadow: 0 10px 28px -16px rgb(124 58 237 / 0.8);
  }
  @media (hover: hover) {
    a.ct-link:hover {
      transform: translateY(-2px);
    }
  }
  a.ct-link:focus-visible {
    outline: 2px solid var(--lavender);
    outline-offset: 3px;
    border-radius: 14px;
  }
  .ct-static {
    cursor: default;
  }

  .ct-ico {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border-radius: 12px;
    color: var(--lavender);
    background: linear-gradient(145deg, rgb(59 130 246 / 0.18), rgb(124 58 237 / 0.24));
    border: 1px solid rgb(167 139 250 / 0.3);
  }
  .ct-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }
  .ct-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.25;
  }
  .ct-value {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  a.ct-link:hover .ct-value {
    color: #cbd5e1;
  }
  .ct-link :global(.ct-go) {
    flex: none;
    color: var(--lavender);
    transition: transform 0.25s ease;
  }
  a.ct-link:hover :global(.ct-go) {
    transform: translateX(2px);
  }

  .ct-more {
    margin-top: 0.75rem;
  }
  /* Strip: a shorter panel with the links side by side where there is room. */
  .is-strip .ct-panel {
    padding: clamp(1.25rem, 3.5vw, 2.25rem);
  }
  .is-strip .section-title {
    font-size: var(--fs-section-title);
  }
  @media (min-width: 900px) {
    .is-strip .ct-panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    }
    .is-strip .ct-list {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    }
  }

  @media (max-width: 420px) {
    .ct-panel {
      padding: 1.15rem;
    }
    .ct-link {
      gap: 0.7rem;
      padding: 0.6rem 0.7rem;
    }
    .ct-value {
      font-size: 0.72rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a.ct-link:hover,
    a.ct-link:hover :global(.ct-go) {
      transform: none;
    }
  }
</style>
