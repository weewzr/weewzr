---
/**
 * Research & Writing. Reads the `notes` content collection (src/content/notes/*.md), groups the
 * published notes by category in the order of `noteCategories` in src/data/site.ts and skips
 * empty categories. With `standalone` it renders the full index page (h1, breadcrumb and
 * category anchors) and is used by src/pages/writing/index.astro. Without it, it is the
 * home-page section with a link to that index.
 */
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { noteCategories } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  standalone?: boolean;
  /** Block heading when not standalone. The research index page uses "Technical notes". */
  heading?: string;
  /** Section id when not standalone; "writing" keeps the old anchor working. */
  sectionId?: string;

}
const { standalone = false, heading, sectionId = 'writing' } = Astro.props;

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title),
);

// Categories are stored in Title Case (content.config.ts); headings show them in sentence case.
const sentence = (value: string) => value.charAt(0) + value.slice(1).toLowerCase();
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const groups = noteCategories
  .map((name) => ({ name: sentence(name), slug: slugify(name), entries: notes.filter((note) => note.data.category === name) }))
  .filter((group) => group.entries.length > 0);

const total = notes.length;
const noun = (n: number) => (n === 1 ? 'note' : 'notes');
const dateFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

// Heading levels depend on where the block sits: h2 > h3 > h4 on the home page, h1 > h2 > h3 on the index page.
const Title = standalone ? 'h1' : 'h2';
const GroupTitle = standalone ? 'h2' : 'h3';
const CardTitle = standalone ? 'h3' : 'h4';
const titleId = standalone ? 'writing-index-title' : 'writing-title';
---

<section id={standalone ? undefined : sectionId} class:list={['section', 'writing', { standalone }]} aria-labelledby={titleId}>
  <div class="container">
    {
      standalone && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li>
              <a href={withBase('')}>Home</a>
            </li>
            <li aria-current="page">Writing</li>
          </ol>
        </nav>
      )
    }

    <header class="head">
      <p class="eyebrow">Technical notes</p>
      <Title id={titleId} class="section-title">{standalone ? 'Writing' : (heading ?? 'Writing')}</Title>
      <p class="section-lead">
        Technical notes and computational studies appear here, grouped by topic. Each entry links to the public source it
        is based on.
      </p>
      {
        standalone && total > 0 && (
          <p class="tally">
            {total} {noun(total)} in {groups.length} {groups.length === 1 ? 'topic' : 'topics'}
          </p>
        )
      }
    </header>

    {
      standalone && groups.length > 1 && (
        <nav class="jump" aria-label="Topics">
          <ul>
            {groups.map((group) => (
              <li>
                <a href={`#cat-${group.slug}`}>
                  {group.name}
                  <span class="jump-count">{group.entries.length}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      total === 0 ? (
        <p class="empty">Notes will appear here as they are published.</p>
      ) : (
        <ul class="groups">
          {groups.map((group) => (
            <li class="group" id={`cat-${group.slug}`}>
              <header class="group-head">
                <GroupTitle class="group-title">{group.name}</GroupTitle>
                <span class="count">
                  {group.entries.length} {noun(group.entries.length)}
                </span>
              </header>
              <ul class="cards">
                {group.entries.map((note) => {
                  const { title, description, kind, date, sourceUrl, sourceLabel } = note.data;
                  return (
                    <li>
                      <article class="note-card">
                        <div class="meta">
                          <span class="chip">{kind}</span>
                          <time datetime={date.toISOString().slice(0, 10)}>{dateFormat.format(date)}</time>
                        </div>
                        <CardTitle class="card-title">
                          <a href={withBase(`writing/${note.id}/`)}>{title}</a>
                        </CardTitle>
                        <p class="desc">{description}</p>
                        <div class="foot">
                          <span class="read" aria-hidden="true">
                            Read note
                            <Icon name="arrow-right" size={16} stroke={2} />
                          </span>
                          {sourceUrl && (
                            <a
                              class="source"
                              href={sourceUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              aria-label={`View source: ${sourceLabel ?? sourceUrl} (opens in a new tab)`}
                            >
                              View source
                              <Icon name="external" size={15} stroke={2} />
                            </a>
                          )}
                        </div>
                      </article>
                    </li>
                  );
                })}
              </ul>
            </li>
          ))}
        </ul>
      )
    }

    {
      !standalone && total > 0 && (
        <p class="more">
          <a class="btn" href={withBase('writing/')}>
            Browse all {total} {noun(total)}
            <Icon name="arrow-right" size={20} />
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .standalone {
    padding-top: clamp(var(--space-6), 5vw, var(--space-7));
  }

  /* Breadcrumb (index page only). */
  .crumbs {
    margin-bottom: var(--space-4);
    font-size: var(--fs-small);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--text-muted);
  }
  .crumbs li:not(:last-child)::after {
    content: '/';
    margin-left: var(--space-3);
    color: var(--border-strong);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .tally {
    margin-top: var(--space-3);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* Category anchors (index page, two or more topics). */
  .jump {
    margin-top: var(--space-5);
  }
  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    color: var(--text);
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color var(--ease),
      background-color var(--ease),
      color var(--ease);
  }
  .jump a:hover {
    color: var(--text);
    border-color: var(--text);
    background: var(--bg-subtle);
  }
  .jump-count {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-muted);
  }

  .empty {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    color: var(--text-muted);
  }

  /* Category groups sit side by side where there is room. */
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-6) var(--space-5);
    align-items: stretch;
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }
  .group {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
  }
  .group-title {
    font-size: var(--fs-card-title);
    font-weight: 600;
  }
  .count {
    flex: none;
    font-size: var(--fs-label);
    color: var(--text-muted);
  }

  .cards {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cards > li:last-child {
    flex: 1;
  }

  /* Note card. The title link is stretched over the whole card; the source link sits above it. */
  .note-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-5);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    transition: border-color var(--ease);
  }
  .note-card:hover,
  .note-card:focus-within {
    border-color: var(--border-strong);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  time {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-muted);
  }
  .card-title {
    font-size: var(--fs-card-title);
    line-height: 1.35;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .card-title a {
    color: var(--text);
    text-decoration: none;
  }
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .note-card:hover .card-title a {
    color: var(--accent);
  }
  @supports selector(:has(*)) {
    .card-title a:focus-visible {
      outline: none;
    }
    .note-card:has(.card-title a:focus-visible) {
      outline: var(--focus-width) solid var(--focus);
      outline-offset: var(--focus-offset);
    }
  }
  .desc {
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }
  .read {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
  }
  .source {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .source:hover {
    color: var(--text);
  }

  .more {
    margin-top: var(--space-6);
  }

  @media (max-width: 639px) {
    .note-card {
      padding: var(--space-4);
    }
  }
</style>
