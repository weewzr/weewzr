---
/**
 * Research & Writing. Reads the `notes` content collection (src/content/notes/*.md), groups the
 * published notes by category in the order of `noteCategories` in src/data/site.ts and skips
 * empty categories. With `standalone` it renders the full index page (h1, breadcrumb and
 * category anchors) and is used by src/pages/writing/index.astro. Without it, it is the
 * home-page section with a link to that index.
 */
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { noteCategories } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title),
);

const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const groups = noteCategories
  .map((name) => ({ name, slug: slugify(name), entries: notes.filter((note) => note.data.category === name) }))
  .filter((group) => group.entries.length > 0);

const total = notes.length;
const noun = (n: number) => (n === 1 ? 'note' : 'notes');
const dateFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

// Heading levels depend on where the block sits: h2 > h3 > h4 on the home page, h1 > h2 > h3 on the index page.
const Title = standalone ? 'h1' : 'h2';
const GroupTitle = standalone ? 'h2' : 'h3';
const CardTitle = standalone ? 'h3' : 'h4';
const titleId = standalone ? 'writing-index-title' : 'writing-title';
---

<section id={standalone ? undefined : 'writing'} class:list={['section', 'writing', { standalone }]} aria-labelledby={titleId}>
  <div class="container">
    {
      standalone && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li>
              <a href={withBase('')}>Home</a>
            </li>
            <li aria-current="page">Notes and studies</li>
          </ol>
        </nav>
      )
    }

    <header class="head reveal">
      <p class="eyebrow">Research &amp; Writing</p>
      <Title id={titleId} class="section-title">Notes and studies</Title>
      <p class="section-lead">
        Technical notes, computational studies, engineering articles and research write-ups appear here, grouped by topic.
        Each entry links to the public source it is based on.
      </p>
      {
        standalone && total > 0 && (
          <p class="tally">
            {total} {noun(total)} in {groups.length} {groups.length === 1 ? 'topic' : 'topics'}
          </p>
        )
      }
    </header>

    {
      standalone && groups.length > 1 && (
        <nav class="jump reveal" aria-label="Topics">
          <ul>
            {groups.map((group) => (
              <li>
                <a href={`#cat-${group.slug}`}>
                  {group.name}
                  <span class="jump-count">{group.entries.length}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      total === 0 ? (
        <p class="empty reveal">Notes will appear here as they are published.</p>
      ) : (
        <ul class="groups">
          {groups.map((group, g) => (
            <li class="group reveal" style={`--i:${g}`} id={`cat-${group.slug}`}>
              <header class="group-head">
                <GroupTitle class="group-title">{group.name}</GroupTitle>
                <span class="count">
                  {group.entries.length} {noun(group.entries.length)}
                </span>
              </header>
              <ul class="cards">
                {group.entries.map((note) => {
                  const { title, description, kind, date, sourceUrl, sourceLabel } = note.data;
                  return (
                    <li>
                      <article class="card glass gradient-border">
                        <div class="meta">
                          <span class="chip">{kind}</span>
                          <time datetime={date.toISOString().slice(0, 10)}>{dateFormat.format(date)}</time>
                        </div>
                        <CardTitle class="card-title">
                          <a href={withBase(`writing/${note.id}/`)}>{title}</a>
                        </CardTitle>
                        <p class="desc">{description}</p>
                        <div class="foot">
                          <span class="read" aria-hidden="true">
                            Read note
                            <Icon name="arrow-right" size={16} stroke={2} />
                          </span>
                          {sourceUrl && (
                            <a
                              class="source"
                              href={sourceUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              aria-label={`View source: ${sourceLabel ?? sourceUrl} (opens in a new tab)`}
                            >
                              View source
                              <Icon name="external" size={15} stroke={2} />
                            </a>
                          )}
                        </div>
                      </article>
                    </li>
                  );
                })}
              </ul>
            </li>
          ))}
        </ul>
      )
    }

    {
      !standalone && total > 0 && (
        <p class="more reveal">
          <a class="btn" href={withBase('writing/')}>
            Browse all {total} {noun(total)}
            <Icon name="arrow-right" size={18} />
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .standalone {
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }

  /* Breadcrumb (index page only). */
  .crumbs {
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
    font-size: 0.9rem;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
  }
  .crumbs li:not(:last-child)::after {
    content: '/';
    margin-left: 0.6rem;
    color: var(--muted);
    opacity: 0.7;
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--lavender);
  }

  .tally {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Category anchors (index page, two or more topics). */
  .jump {
    margin-top: 1.75rem;
  }
  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.04);
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }
  .jump a:hover {
    color: #fff;
    border-color: rgb(167 139 250 / 0.6);
    background: rgb(124 58 237 / 0.18);
    transform: translateY(-2px);
  }
  .jump-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--lavender);
  }

  .empty {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  /* Category groups sit side by side where there is room. */
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: clamp(2rem, 4vw, 2.75rem) clamp(1.25rem, 2.5vw, 1.75rem);
    align-items: stretch;
    margin: clamp(2rem, 4.5vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .group {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .group-head {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.7rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .group-head::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 3.5rem;
    height: 2px;
    border-radius: 2px;
    background: var(--grad);
  }
  .group-title {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .count {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--muted);
  }

  .cards {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cards > li:last-child {
    flex: 1;
  }

  /* Note card. The title link is stretched over the whole card; the source link sits above it. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    height: 100%;
    padding: 1.25rem 1.3rem 0.9rem;
    border-radius: var(--radius);
    background: linear-gradient(155deg, rgb(17 36 76 / 0.62), rgb(9 20 44 / 0.62));
    box-shadow: 0 22px 50px -34px rgb(0 0 0 / 0.85);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.3s ease;
  }
  .card:hover,
  .card:focus-within {
    transform: translateY(-4px);
    box-shadow:
      0 28px 56px -32px rgb(0 0 0 / 0.9),
      0 0 38px rgb(59 130 246 / 0.2),
      0 0 60px rgb(124 58 237 / 0.22);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  time {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .card-title {
    font-size: 1.2rem;
    line-height: 1.25;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .card-title a {
    color: var(--text);
    text-decoration: none;
  }
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .card:hover .card-title a {
    color: #fff;
  }
  @supports selector(:has(*)) {
    .card-title a:focus-visible {
      outline: none;
    }
    .card:has(.card-title a:focus-visible) {
      outline: 2px solid var(--lavender);
      outline-offset: 3px;
    }
  }
  .desc {
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.6;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.35rem;
    border-top: 1px solid var(--line);
  }
  .read {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--lavender);
  }
  .read :global(svg) {
    transition: transform 0.3s ease;
  }
  .card:hover .read :global(svg) {
    transform: translateX(4px);
  }
  .source {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding-inline: 0.15rem;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .source:hover {
    color: var(--text);
  }

  .more {
    margin-top: clamp(2rem, 4.5vw, 3rem);
  }

  @media (max-width: 480px) {
    .card {
      padding: 1.1rem 1.1rem 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover,
    .card:focus-within {
      transform: none;
      transition: none;
    }
    .read :global(svg),
    .card:hover .read :global(svg) {
      transform: none;
      transition: none;
    }
    .jump a:hover {
      transform: none;
    }
  }
</style>
