---
import Icon from './Icon.astro';
import { education, aboutParagraphs, affiliations, researchInterests } from '../data/site';

// Everything below is derived from src/data/site.ts at build time.
const strip = (value: string, prefix: RegExp) => value.replace(prefix, '').trim();
const institutionShort = education.institution.match(/\(([^)]+)\)/)?.[1] ?? education.institution;
const minor = strip(education.minor, /^Minor in\s+/i);
const specialisation = strip(education.specialisation, /^Specialisation in\s+/i);
const involvement = researchInterests.find((r) => r.kind === 'involvement');

const facts = [
  { label: 'Institution', value: institutionShort },
  { label: 'Field', value: education.degree },
  ...(involvement ? [{ label: 'Research', value: `${involvement.title.split(' ')[0]} research involvement` }] : []),
  { label: 'Focus', value: specialisation },
];
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="ab-wrap">
    <header class="reveal">
      <p class="eyebrow">Profile</p>
      <h2 id="about-title" class="section-title">About</h2>
    </header>

    <div class="ab-grid">
      <div class="ab-main">
        <div class="ab-copy">
          {
            aboutParagraphs.map((text, i) => (
              <p class:list={['reveal', { 'ab-first': i === 0 }]} style={`--i:${i}`}>
                {text}
              </p>
            ))
          }
        </div>

        <ul class="ab-facts" role="list" aria-label="At a glance">
          {
            facts.map((fact, i) => (
              <li class="ab-fact reveal" style={`--i:${i}`}>
                <span class="ab-fact-label">{fact.label}</span>
                <span class="ab-fact-value">{fact.value}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="ab-side">
        <article class="ab-card glass gradient-border reveal" style="--i:1">
          <header class="ab-card-head">
            <span class="ab-ico"><Icon name="book" size={20} /></span>
            <h3>Education</h3>
          </header>
          <p class="ab-inst">{education.institution}</p>
          <dl class="ab-edu">
            <div>
              <dt>Degree</dt>
              <dd>{education.degree}</dd>
            </div>
            <div>
              <dt>Minor</dt>
              <dd>{minor}</dd>
            </div>
            <div>
              <dt>Specialisation</dt>
              <dd>{specialisation}</dd>
            </div>
          </dl>
        </article>

        <article class="ab-card glass gradient-border reveal" style="--i:2">
          <header class="ab-card-head">
            <span class="ab-ico"><Icon name="atom" size={20} /></span>
            <h3>Affiliations</h3>
          </header>
          <p class="ab-intro">Research involvement and affiliations at NUS</p>
          <ul class="ab-aff" role="list">
            {
              affiliations.map((aff) => (
                <li>
                  <a class="ab-unit" href={aff.url} target="_blank" rel="noopener noreferrer">
                    <span class="ab-unit-name">{aff.unit}</span>
                    <Icon name="external" size={15} class="ab-ext" />
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                  {aff.people.length > 0 && (
                    <div class="ab-people">
                      <span class="ab-people-label">People</span>
                      <ul role="list">
                        {aff.people.map((person) => (
                          <li>{person}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {aff.note && <p class="ab-note">{aff.note}</p>}
                </li>
              ))
            }
          </ul>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .ab-wrap {
    width: min(100% - 2rem, var(--maxw));
    max-width: var(--maxw);
    margin-inline: auto;
  }
  .ab-grid {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    margin-top: 2.25rem;
  }
  @media (min-width: 900px) {
    .ab-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      align-items: start;
    }
  }

  .ab-main {
    display: grid;
    gap: 2rem;
    min-width: 0;
  }
  .ab-copy {
    display: grid;
    gap: 1.15rem;
    max-width: 64ch;
  }
  .ab-copy p {
    color: #cbd5e1;
  }
  .ab-copy .ab-first {
    color: var(--text);
    font-size: clamp(1.125rem, 1.6vw, 1.28rem);
    line-height: 1.6;
  }

  /* Compact fact strip */
  .ab-facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .ab-fact {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    padding: 0.8rem 0.95rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    border-left: 2px solid var(--blue-2);
    background: rgb(11 27 58 / 0.4);
  }
  .ab-fact:nth-child(even) {
    border-left-color: var(--lavender);
  }
  .ab-fact-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ab-fact-value {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.02rem;
    line-height: 1.3;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  /* Side column cards */
  .ab-side {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }
  .ab-card {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    min-width: 0;
  }
  .ab-card-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .ab-ico {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border-radius: 12px;
    color: var(--lavender);
    background: linear-gradient(145deg, rgb(59 130 246 / 0.18), rgb(124 58 237 / 0.22));
    border: 1px solid rgb(167 139 250 / 0.3);
  }
  .ab-card h3 {
    font-size: 1.2rem;
    font-weight: 600;
  }

  .ab-inst {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.35;
  }
  .ab-edu {
    margin: 1rem 0 0;
    display: grid;
    gap: 0.85rem;
  }
  .ab-edu > div {
    padding-left: 0.9rem;
    border-left: 2px solid rgb(167 139 250 / 0.45);
  }
  .ab-edu dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ab-edu dd {
    margin: 0.1rem 0 0;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .ab-intro {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.97rem;
  }
  .ab-aff {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }
  .ab-aff > li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    min-width: 0;
  }
  .ab-unit {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    max-width: 100%;
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.35;
    text-decoration: none;
  }
  .ab-unit-name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: rgb(167 139 250 / 0.5);
    overflow-wrap: anywhere;
  }
  .ab-unit:hover .ab-unit-name {
    text-decoration-color: currentColor;
  }
  .ab-unit :global(.ab-ext) {
    flex: none;
    opacity: 0.85;
  }
  .ab-unit:focus-visible {
    outline: 2px solid var(--lavender);
    outline-offset: 3px;
    border-radius: 6px;
  }
  .ab-people {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-top: 0.15rem;
  }
  .ab-people-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ab-people ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 1.1rem;
  }
  .ab-people li {
    color: var(--text);
    font-size: 0.98rem;
  }
  .ab-note {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
