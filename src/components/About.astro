---
import Icon from './Icon.astro';
import { education, aboutParagraphs, affiliations, researchInterests } from '../data/site';

/**
 * Profile block: about paragraphs, a fact strip, education and affiliations.
 * `heading` false drops the block header (the About page has its own h1) and lifts the card titles to h2.
 */
interface Props {
  heading?: boolean;
}
const { heading = true } = Astro.props;
const CardTitle = heading ? 'h3' : 'h2';

// Everything below is derived from src/data/site.ts at build time.
const strip = (value: string, prefix: RegExp) => value.replace(prefix, '').trim();
const institutionShort = education.institution.match(/\(([^)]+)\)/)?.[1] ?? education.institution;
const minor = strip(education.minor, /^Minor in\s+/i);
const specialisation = strip(education.specialisation, /^Specialisation in\s+/i);
const involvement = researchInterests.find((r) => r.kind === 'involvement');

const facts = [
  { label: 'Institution', value: institutionShort },
  { label: 'Field', value: education.degree },
  ...(involvement ? [{ label: 'Research', value: `${involvement.title.split(' ')[0]} research involvement` }] : []),
  { label: 'Focus', value: specialisation },
];
---

<section id={heading ? 'about' : 'profile'} class="block" aria-labelledby={heading ? 'about-title' : undefined} aria-label={heading ? undefined : 'Profile'}>
  <div class="ab-wrap">
    {
      heading && (
        <header>
          <p class="eyebrow">Profile</p>
          <h2 id="about-title" class="section-title">About</h2>
        </header>
      )
    }

    <div class="ab-grid">
      <div class="ab-main">
        <div class="ab-copy">
          {
            aboutParagraphs.map((text, i) => (
              <p class:list={[{ 'ab-first': i === 0 }]}>
                {text}
              </p>
            ))
          }
        </div>

        <ul class="ab-facts" role="list" aria-label="At a glance">
          {
            facts.map((fact) => (
              <li class="ab-fact">
                <span class="ab-fact-label">{fact.label}</span>
                <span class="ab-fact-value">{fact.value}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="ab-side">
        <article class="ab-card">
          <header class="ab-card-head">
            <span class="ab-ico"><Icon name="book" size={20} /></span>
            <CardTitle>Education</CardTitle>
          </header>
          <p class="ab-inst">{education.institution}</p>
          <dl class="ab-edu">
            <div>
              <dt>Degree</dt>
              <dd>{education.degree}</dd>
            </div>
            <div>
              <dt>Minor</dt>
              <dd>{minor}</dd>
            </div>
            <div>
              <dt>Specialisation</dt>
              <dd>{specialisation}</dd>
            </div>
          </dl>
        </article>

        <article class="ab-card">
          <header class="ab-card-head">
            <span class="ab-ico"><Icon name="atom" size={20} /></span>
            <CardTitle>Affiliations</CardTitle>
          </header>
          <p class="ab-intro">Research involvement and affiliations at NUS</p>
          <ul class="ab-aff" role="list">
            {
              affiliations.map((aff) => (
                <li>
                  <a class="ab-unit" href={aff.url} target="_blank" rel="noopener noreferrer">
                    <span class="ab-unit-name">{aff.unit}</span>
                    <Icon name="external" size={15} class="ab-ext" />
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                  {aff.people.length > 0 && (
                    <div class="ab-people">
                      <span class="ab-people-label">People</span>
                      <ul role="list">
                        {aff.people.map((person) => (
                          <li>{person}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {aff.note && <p class="ab-note">{aff.note}</p>}
                </li>
              ))
            }
          </ul>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .ab-wrap {
    width: min(100% - 2rem, var(--maxw));
    max-width: var(--maxw);
    margin-inline: auto;
  }
  .ab-grid {
    display: grid;
    gap: var(--space-6);
    margin-top: 0;
  }
  @media (min-width: 900px) {
    .ab-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      align-items: start;
    }
  }

  .ab-main {
    display: grid;
    gap: var(--space-6);
    min-width: 0;
  }
  .ab-copy {
    display: grid;
    gap: var(--space-4);
    max-width: 68ch;
  }
  .ab-copy p {
    color: var(--text-muted);
  }
  .ab-copy .ab-first {
    color: var(--text);
    font-size: var(--fs-lead);
    line-height: 1.6;
  }

  /* Facts as a definition grid with hairlines. */
  .ab-facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-5);
  }
  .ab-fact {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--border);
  }
  .ab-fact-label {
    font-size: var(--fs-label);
    color: var(--text-muted);
  }
  .ab-fact-value {
    font-weight: 500;
    font-size: var(--fs-body);
    line-height: 1.3;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  /* Side column cards */
  .ab-side {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }
  .ab-card {
    padding: var(--space-4);
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  @media (min-width: 640px) {
    .ab-card {
      padding: var(--space-5);
    }
  }
  .ab-card-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .ab-ico {
    display: inline-flex;
    flex: none;
    color: var(--text-muted);
  }
  .ab-card :is(h2, h3) {
    font-size: var(--fs-card-title);
    font-weight: 600;
    line-height: 1.35;
  }

  .ab-inst {
    margin-top: var(--space-3);
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: 1.35;
  }
  .ab-edu {
    margin: var(--space-3) 0 0;
    display: grid;
  }
  .ab-edu > div {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--border);
  }
  .ab-edu dt {
    font-size: var(--fs-label);
    color: var(--text-muted);
  }
  .ab-edu dd {
    margin: var(--space-1) 0 0;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .ab-intro {
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .ab-aff {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .ab-aff > li {
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    min-width: 0;
  }
  .ab-unit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    max-width: 100%;
    font-weight: 500;
    line-height: 1.35;
    text-decoration: none;
  }
  .ab-unit-name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  .ab-unit :global(.ab-ext) {
    flex: none;
  }
  .ab-people {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }
  .ab-people-label {
    font-size: var(--fs-label);
    color: var(--text-muted);
  }
  .ab-people ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
  .ab-people li {
    color: var(--text);
    font-size: var(--fs-small);
  }
  .ab-note {
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
</style>
