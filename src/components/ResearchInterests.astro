---
import { researchInterests } from '../data/site';

/**
 * Research and engineering interests, in the canonical order of docs/DESIGN_SYSTEM.md A13.
 * Props:
 *   id     section id (the About page uses "interests")
 *   title  block heading
 */
interface Props {
  id?: string;
  title?: string;
}
const { id = 'interests', title = 'Research and engineering interests' } = Astro.props;

const badgeText = {
  involvement: 'Research involvement',
  interest: 'Interest',
} as const;
---

<section id={id} class="block" aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`} class="section-title">{title}</h2>
    <p class="section-lead">
      Nuclear engineering is the area where I have research involvement. The others are interests that shape my studies
      and public projects.
    </p>

    <ul class="card-grid ri-grid" role="list">
      {
        researchInterests.map((item) => (
          <li>
            <article class="card">
              <p class="card__meta">{badgeText[item.kind]}</p>
              <h3 class="card__title">{item.title}</h3>
              <p class="card__summary">{item.summary}</p>
              <ul class="card__tags" aria-label={`Keywords for ${item.title}`}>
                {item.keywords.map((kw) => (
                  <li class="chip">{kw}</li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ri-grid {
    margin-top: var(--space-5);
  }
</style>
