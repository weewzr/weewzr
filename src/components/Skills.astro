---
/**
 * Technical skills as one plain table: category and the tools or methods in it. No counters and no proficiency
 * ratings; the public repositories show how each one is used.
 */
import { skills } from '../data/site';
---

<section id="skills" class="block" aria-labelledby="skills-title">
  <div class="container">
    <h2 id="skills-title" class="section-title">Technical skills</h2>
    <p class="section-lead">
      Each entry is a tool or method evidenced in my public repositories or stated by me. I do not rate proficiency.
    </p>
    <div class="table-scroll sk-table" role="region" tabindex="0" aria-labelledby="skills-title">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Category</th>
            <th scope="col">Tools and methods</th>
          </tr>
        </thead>
        <tbody>
          {
            skills.map((group) => (
              <tr>
                <th scope="row">{group.category}</th>
                <td>{group.items.join(', ')}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .sk-table {
    margin-top: var(--space-5);
    max-width: 52rem;
  }
  .sk-table tbody th {
    width: 12rem;
    font-weight: 600;
    text-align: left;
  }
</style>
