---
import Icon from './Icon.astro';
import { skills } from '../data/site';

const pad = (n: number) => String(n).padStart(2, '0');
const totalItems = skills.reduce((sum, group) => sum + group.items.length, 0);
---

<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="sk-wrap">
    <header>
      <p class="eyebrow">Skills inventory</p>
      <h2 id="skills-title" class="section-title">Technical Skills</h2>
      <p class="section-lead">
        Each entry is a tool or method evidenced in my public repositories or stated by me. I do not rate proficiency.
      </p>
    </header>

    <ul class="sk-grid" role="list">
      {
        skills.map((group) => (
          <li class="sk-item">
            <article class="sk-card">
              <header class="sk-head">
                <span class="sk-ico">
                  <Icon name={group.icon} size={20} />
                </span>
                <h3>{group.category}</h3>
              </header>
              <ul class="sk-list" role="list" aria-label={`${group.category} skills`}>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <p class="sk-count">{pad(group.items.length)} entries</p>
            </article>
          </li>
        ))
      }
    </ul>

    <p class="sk-total">inventory: {skills.length} categories, {totalItems} entries</p>
  </div>
</section>

<style>
  .sk-wrap {
    width: min(100% - 2rem, var(--maxw));
    max-width: var(--maxw);
    margin-inline: auto;
  }
  .sk-grid {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }
  @media (min-width: 640px) {
    .sk-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .sk-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .sk-item {
    min-width: 0;
    display: flex;
  }
  .sk-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  @media (min-width: 640px) {
    .sk-card {
      padding: var(--space-5);
    }
  }
  .sk-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .sk-ico {
    display: inline-flex;
    flex: none;
    color: var(--text-muted);
  }
  .sk-card h3 {
    font-size: var(--fs-card-title);
    font-weight: 600;
    line-height: 1.35;
  }
  .sk-list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
  }
  .sk-list li {
    padding: var(--space-2) 0;
    border-top: 1px solid var(--border);
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .sk-count {
    margin-top: auto;
    padding-top: var(--space-4);
    font-size: var(--fs-label);
    color: var(--text-muted);
  }
  .sk-total {
    margin-top: var(--space-5);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
</style>
