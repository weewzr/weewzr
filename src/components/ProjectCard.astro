---
/**
 * One featured-project card. All text comes from the Project object in src/data/site.ts.
 * Even indexes put the preview image on the left on wide screens, odd indexes on the right.
 */
import Icon from './Icon.astro';
import { withBase } from '../lib/url';
import type { Project } from '../data/site';

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const flip = index % 2 === 1;
const titleId = `project-${project.slug}-title`;
const caseHref = withBase(`projects/${project.slug}/`);

// Preview images ship as name.webp (1280 wide) and name-640.webp (640 wide).
const full = withBase(project.image);
const small = project.image.endsWith('.webp') ? withBase(project.image.replace(/\.webp$/, '-640.webp')) : null;
const srcset = small ? `${small} 640w, ${full} 1280w` : undefined;
---

<article class="card glass gradient-border" data-flip={flip ? 'true' : 'false'} aria-labelledby={titleId}>
  <figure class="media">
    <div class="frame">
      <img
        src={full}
        srcset={srcset}
        sizes="(min-width: 1180px) 570px, (min-width: 900px) 48vw, 100vw"
        width="1280"
        height="800"
        loading="lazy"
        decoding="async"
        alt={project.imageAlt}
      />
    </div>
    <figcaption>{project.imageCaption}</figcaption>
  </figure>

  <div class="body">
    <p class="status">{project.status}</p>
    <h3 id={titleId}>{project.name}</h3>
    <p class="tagline">{project.tagline}</p>
    <p class="desc">{project.description}</p>

    <h4 class="mini-title">Main features</h4>
    <ul class="features">
      {
        project.features.map((feature) => (
          <li>
            <span class="tick"><Icon name="check" size={16} stroke={2.2} /></span>
            <span>{feature}</span>
          </li>
        ))
      }
    </ul>

    <ul class="tech" aria-label={`${project.name} technologies`}>
      {project.tech.map((t) => <li class="chip">{t}</li>)}
    </ul>

    <div class="actions">
      {
        project.siteUrl && (
          <a
            class="btn btn-primary"
            href={project.siteUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit Website for ${project.name} (opens in a new tab)`}
          >
            Visit Website
            <Icon name="external" size={18} />
          </a>
        )
      }
      <a
        class="btn"
        href={project.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`View GitHub Repository for ${project.name} (opens in a new tab)`}
      >
        <Icon name="github" size={18} />
        View GitHub Repository
      </a>
    </div>

    {
      !project.siteUrl && project.comingSoon && (
        <>
          {/* Developer note: the site URL is configurable in src/data/site.ts (siteUrl). Never link futureSiteUrl here. */}
          <p class="soon">
            <span class="soon-label">Website Coming Soon</span>
          </p>
        </>
      )
    }

    <a class="case-link" href={caseHref}>
      Read case study<span class="sr-only"> for {project.name}</span>
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.75rem);
    align-items: center;
    padding: clamp(1rem, 2.4vw, 1.75rem);
    border-radius: 24px;
    background: linear-gradient(155deg, rgb(17 36 76 / 0.62), rgb(9 20 44 / 0.62));
    box-shadow:
      0 26px 60px -36px rgb(0 0 0 / 0.85),
      0 0 38px rgb(59 130 246 / 0.07),
      0 0 60px rgb(124 58 237 / 0.07);
    transition:
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.35s ease;
  }
  .card:hover,
  .card:focus-within {
    transform: translateY(-5px);
    box-shadow:
      0 34px 70px -34px rgb(0 0 0 / 0.9),
      0 0 46px rgb(59 130 246 / 0.24),
      0 0 78px rgb(124 58 237 / 0.3);
  }

  /* Image column. */
  .media {
    margin: 0;
    min-width: 0;
  }
  .card[data-flip='true'] .media {
    order: 2;
  }
  .frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgb(148 163 184 / 0.22);
    background: var(--bg-2);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.9);
    aspect-ratio: 16 / 10;
  }
  .frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover .frame img {
    transform: scale(1.02);
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
    text-align: center;
  }

  /* Text column. */
  .body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    margin: 0;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: #ddd6fe;
    background: rgb(124 58 237 / 0.16);
    border: 1px solid rgb(167 139 250 / 0.38);
  }
  .status::before {
    content: '';
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--lavender);
    box-shadow: 0 0 8px var(--lavender);
  }
  h3 {
    margin-top: 0.85rem;
    font-size: clamp(1.7rem, 3.2vw, 2.25rem);
    font-weight: 600;
    color: #fff;
  }
  .tagline {
    margin-top: 0.4rem;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--lavender);
  }
  .desc {
    margin-top: 0.9rem;
    font-size: 0.96rem;
    line-height: 1.65;
    color: #cbd5e1;
  }
  .mini-title {
    margin: 1.2rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .features {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .features li {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr);
    gap: 0.6rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: #cbd5e1;
  }
  .tick {
    display: inline-flex;
    margin-top: 0.2rem;
    color: var(--blue-2);
  }
  .tech {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.35rem;
  }
  .actions .btn {
    min-height: 44px;
  }
  .soon {
    margin: 0.85rem 0 0;
  }
  .soon-label {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--muted);
    border: 1px dashed rgb(148 163 184 / 0.4);
  }
  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
    color: #c4b5fd;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .case-link :global(svg) {
    transition: transform 0.25s ease;
  }
  .case-link:hover {
    color: #fff;
  }
  .case-link:hover :global(svg) {
    transform: translateX(4px);
  }

  @media (max-width: 899px) {
    .card {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
    .card[data-flip='true'] .media {
      order: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card:focus-within {
      transform: none;
    }
    .card:hover .frame img {
      transform: none;
    }
  }
</style>
