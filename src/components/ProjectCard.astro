---
/**
 * One project, as a row: the project's own figure on the left (5 of 12 columns on wide screens), the text on the
 * right. All text comes from the Project object in src/data/site.ts.
 * Props:
 *   project       a Project from site.ts
 *   headingLevel  'h2' | 'h3' (default 'h3')
 *   variant       'row' (home page: one sentence, one checked result) or 'full' (projects page: the description,
 *                 the main features and the technologies as well)
 *   eager         load the image eagerly (first row above the fold)
 * Research areas are plain text separated by middle dots; technologies are outlined tags. One link row:
 * case study, live site and code. A project with no live site says "Website coming soon" in plain text.
 */
import Icon from './Icon.astro';
import StatusPill from './StatusPill.astro';
import { withBase } from '../lib/url';
import { researchInterests } from '../data/site';
import type { Project } from '../data/site';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
  variant?: 'row' | 'full';
  eager?: boolean;
}

const { project, headingLevel = 'h3', variant = 'row', eager = false } = Astro.props;
const Heading = headingLevel;
const full = variant === 'full';
const titleId = `project-${project.slug}-title`;
const planned = project.stage === 'planned';
const areaLabels = project.areas
  .map((id) => researchInterests.find((r) => r.id === id)?.short)
  .filter((label): label is string => Boolean(label));
const caseHref = withBase(`projects/${project.slug}/`);
// Preview images ship as name.webp (1280 wide) and name-640.webp (640 wide).
const big = project.image ? withBase(project.image) : null;
const small = project.image?.endsWith('.webp') ? withBase(project.image.replace(/\.webp$/, '-640.webp')) : null;
const srcset = small && big ? `${small} 640w, ${big} 1280w` : undefined;
const tone = planned ? 'planned' : project.stage === 'live' ? 'live' : 'released';
---

<article class:list={['prow', { 'prow--full': full }]} aria-labelledby={titleId}>
  <figure class="prow__media">
    {
      big ? (
        <div class="prow__frame">
          <img
            src={big}
            srcset={srcset}
            sizes="(min-width: 1120px) 440px, (min-width: 768px) 40vw, 100vw"
            width="1280"
            height="800"
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            alt={project.imageAlt}
          />
        </div>
      ) : (
        <div class="prow__frame prow__frame--empty">
          <span>Planned. No code or screenshot yet.</span>
        </div>
      )
    }
    {project.imageCaption && <figcaption>{project.imageCaption}</figcaption>}
  </figure>

  <div class="prow__body">
    <p class="prow__status">
      <StatusPill label={project.status} tone={tone} />
    </p>
    <Heading id={titleId} class="prow__title">
      <a href={caseHref}>{project.name}</a>
    </Heading>
    <p class="prow__tagline">{project.tagline}</p>

    <p class="prow__desc">{full ? project.description : project.computes}</p>

    {
      full && project.features.length > 0 && (
        <ul class="prow__features" aria-label={`${project.name}: main features`}>
          {project.features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
      )
    }

    {
      project.result && (
        <div class="prow__result">
          <p class="prow__result-kind">{project.result.kind}</p>
          <p class="prow__result-line">
            <span class="prow__result-value">{project.result.value}</span>{' '}
            <span class="prow__result-detail">{project.result.detail}</span>
          </p>
          <p class="prow__result-source">
            Source:{' '}
            <a href={project.result.sourceUrl} target="_blank" rel="noopener noreferrer">
              {project.result.source}
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </p>
        </div>
      )
    }

    {
      areaLabels.length > 0 && (
        <ul class="areas-line prow__areas" aria-label={`${project.name}: research areas`}>
          {areaLabels.map((label) => (
            <li>{label}</li>
          ))}
        </ul>
      )
    }

    {
      full && project.tech.length > 0 && (
        <ul class="prow__tech" aria-label={`${project.name}: technologies`}>
          {project.tech.map((t) => (
            <li class="chip">{t}</li>
          ))}
        </ul>
      )
    }

    <ul class="prow__links" aria-label={`${project.name}: links`}>
      <li>
        <a class="prow__link prow__link--main" href={caseHref}>
          {planned ? 'Read the plan' : 'Case study'}
          <span class="sr-only"> for {project.name}</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </li>
      {
        project.siteUrl && (
          <li>
            <a class="prow__link" href={project.siteUrl} target="_blank" rel="noopener noreferrer">
              Live site<span class="sr-only"> of {project.name} (opens in a new tab)</span>
              <Icon name="external" size={16} />
            </a>
          </li>
        )
      }
      {
        project.repoUrl && (
          <li>
            <a class="prow__link" href={project.repoUrl} target="_blank" rel="noopener noreferrer">
              Code<span class="sr-only"> of {project.name} on GitHub (opens in a new tab)</span>
              <Icon name="github" size={16} />
            </a>
          </li>
        )
      }
      {!project.siteUrl && project.comingSoon && <li class="prow__soon">Website coming soon</li>}
    </ul>
  </div>
</article>

<style>
  .prow {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
  }
  @media (min-width: 768px) {
    .prow {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }

  .prow__media {
    margin: 0;
    min-width: 0;
  }
  .prow__frame {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .prow__frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .prow__frame--empty {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border-style: dashed;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .prow__media figcaption {
    margin-top: var(--space-2);
    font-size: var(--fs-label);
    line-height: 1.45;
    color: var(--text-muted);
  }

  .prow__body {
    min-width: 0;
  }
  .prow__status {
    margin: 0;
  }
  .prow__title {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-section-title);
    line-height: 1.2;
  }
  .prow__title a {
    color: var(--text);
    text-decoration: none;
  }
  .prow__title a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .prow__tagline {
    margin-top: var(--space-1);
    max-width: var(--measure);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .prow__desc {
    margin-top: var(--space-3);
    max-width: var(--measure);
    line-height: 1.6;
  }
  .prow--full .prow__desc {
    font-size: var(--fs-small);
  }
  .prow__features {
    margin: var(--space-3) 0 0;
    padding-left: var(--space-5);
    list-style: disc;
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  .prow__features li + li {
    margin-top: var(--space-1);
  }
  .prow__features li::marker {
    color: var(--text-muted);
  }

  /* The checked result: a hairline-ruled block, the value in mono, the kind of evidence named above it. */
  .prow__result {
    margin-top: var(--space-4);
    padding: var(--space-3) 0 var(--space-3) var(--space-4);
    border-left: 2px solid var(--accent);
    max-width: var(--measure);
  }
  .prow__result-kind {
    font-size: var(--fs-label);
    font-weight: 500;
    color: var(--text-muted);
  }
  .prow__result-line {
    margin-top: var(--space-1);
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .prow__result-value {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
  }
  .prow__result-source {
    margin-top: var(--space-1);
    font-size: var(--fs-label);
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .prow__areas {
    margin-top: var(--space-4);
  }
  .prow__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .prow__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-5);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .prow__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--touch-min);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }
  .prow__link:hover {
    text-decoration: underline;
  }
  .prow__soon {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
</style>
