---
/**
 * One featured-project card. All text comes from the Project object in src/data/site.ts.
 * Props:
 *   project       a Project from site.ts
 *   index         position in the list; odd indexes put the preview on the right on wide screens
 *   headingLevel  'h2' | 'h3' (default 'h3')
 * A planned project (no repository, no image) shows a labelled planned panel in place of the screenshot and no
 * repository or site button.
 */
import Icon from './Icon.astro';
import StatusPill from './StatusPill.astro';
import { withBase } from '../lib/url';
import { researchInterests } from '../data/site';
import type { Project } from '../data/site';

interface Props {
  project: Project;
  index?: number;
  headingLevel?: 'h2' | 'h3';
}

const { project, index = 0, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const flip = index % 2 === 1;
const titleId = `project-${project.slug}-title`;
const planned = project.stage === 'planned';
// Research-area badges: short labels from researchInterests, in the order the project lists them.
const areaLabels = project.areas
  .map((id) => researchInterests.find((r) => r.id === id)?.short)
  .filter((label): label is string => Boolean(label));
const caseHref = withBase(`projects/${project.slug}/`);

// Preview images ship as name.webp (1280 wide) and name-640.webp (640 wide).
const full = project.image ? withBase(project.image) : null;
const small = project.image && project.image.endsWith('.webp') ? withBase(project.image.replace(/\.webp$/, '-640.webp')) : null;
const srcset = small && full ? `${small} 640w, ${full} 1280w` : undefined;
const tone = planned ? 'planned' : project.stage === 'live' ? 'live' : 'released';
---

<article class="pcard" data-flip={flip ? 'true' : 'false'} aria-labelledby={titleId}>
  <figure class="media">
    {
      full ? (
        <div class="frame">
          <img
            src={full}
            srcset={srcset}
            sizes="(min-width: 1180px) 570px, (min-width: 900px) 48vw, 100vw"
            width="1280"
            height="800"
            loading="lazy"
            decoding="async"
            alt={project.imageAlt}
          />
        </div>
      ) : (
        <div class="frame frame--planned">
          <svg viewBox="0 0 320 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
            <defs>
              <pattern id={`grid-${project.slug}`} width="20" height="20" patternUnits="userSpaceOnUse">
                <path class="pgrid" d="M20 0H0V20" fill="none" stroke-width="0.6" />
              </pattern>
            </defs>
            <rect width="320" height="200" fill={`url(#grid-${project.slug})`} />
            <ellipse class="pring pring--a" cx="160" cy="100" rx="86" ry="30" fill="none" stroke-width="1.2" stroke-dasharray="4 6" />
            <ellipse class="pring pring--b" cx="160" cy="100" rx="86" ry="30" transform="rotate(60 160 100)" fill="none" stroke-width="1.2" stroke-dasharray="4 6" />
            <circle class="pdot" cx="160" cy="100" r="4" />
          </svg>
          <span class="frame__label">Planned. No code or screenshot yet.</span>
        </div>
      )
    }
    {project.imageCaption && <figcaption>{project.imageCaption}</figcaption>}
  </figure>

  <div class="body">
    <StatusPill label={project.status} tone={tone} />
    <Heading id={titleId}>{project.name}</Heading>
    <p class="tagline">{project.tagline}</p>
    <p class="desc">{project.description}</p>

    {
      project.features.length > 0 && (
        <>
          <p class="mini-title">Main features</p>
          <ul class="features">
            {project.features.map((feature) => (
              <li>
                <span class="tick"><Icon name="check" size={16} stroke={2.2} /></span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </>
      )
    }

    {
      areaLabels.length > 0 && (
        <ul class="areas" aria-label={`${project.name} research areas`}>
          {areaLabels.map((label) => (
            <li class="chip">{label}</li>
          ))}
        </ul>
      )
    }

    {
      project.tech.length > 0 && (
        <ul class="tech" aria-label={`${project.name} technologies`}>
          {project.tech.map((t) => <li class="chip">{t}</li>)}
        </ul>
      )
    }

    {
      (project.siteUrl || project.repoUrl) && (
        <div class="actions">
          {project.siteUrl && (
            <a
              class="btn btn-primary"
              href={project.siteUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Visit Website for ${project.name} (opens in a new tab)`}
            >
              Visit Website
              <Icon name="external" size={20} />
            </a>
          )}
          {project.repoUrl && (
            <a
              class="btn"
              href={project.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`View GitHub Repository for ${project.name} (opens in a new tab)`}
            >
              <Icon name="github" size={20} />
              View GitHub Repository
            </a>
          )}
        </div>
      )
    }

    {
      !project.siteUrl && project.comingSoon && (
        <p class="soon">
          <span class="soon-label">Website Coming Soon</span>
        </p>
      )
    }

    <a class="case-link" href={caseHref}>
      {planned ? 'Read the plan' : 'Read case study'}<span class="sr-only"> for {project.name}</span>
      <Icon name="arrow-right" size={20} />
    </a>
  </div>
</article>

<style>
  .pcard {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-5);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
  }

  /* Image column. */
  .media {
    margin: 0;
    min-width: 0;
  }
  .pcard[data-flip='true'] .media {
    order: 2;
  }
  /* The image keeps its own aspect ratio: nothing is cropped. */
  .frame {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-subtle);
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Neutral drawn panel for a project with no screenshot yet. */
  .frame--planned {
    display: grid;
    place-items: center;
    border-style: dashed;
    aspect-ratio: 16 / 10;
  }
  .frame--planned svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .pgrid {
    stroke: var(--border);
  }
  .pring--a {
    stroke: var(--accent);
    stroke-opacity: 0.6;
  }
  .pring--b {
    stroke: var(--cyan);
    stroke-opacity: 0.6;
  }
  .pdot {
    fill: var(--accent);
  }
  .frame__label {
    position: relative;
    max-width: 90%;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    text-align: center;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px dashed var(--border-strong);
  }
  figcaption {
    margin-top: var(--space-2);
    font-size: var(--fs-label);
    line-height: 1.5;
    color: var(--text-muted);
    text-align: center;
  }

  /* Text column. */
  .body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  h2,
  h3 {
    margin-top: var(--space-2);
    font-size: var(--fs-section-title);
    font-weight: 600;
    color: var(--text);
  }
  .tagline {
    margin-top: var(--space-1);
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--text-muted);
  }
  .desc {
    margin-top: var(--space-3);
    max-width: 68ch;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--text);
  }
  .mini-title {
    margin: var(--space-4) 0 0;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--text);
  }
  .features {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
  .features li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: var(--space-2);
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--text);
  }
  .tick {
    display: inline-flex;
    margin-top: 0.2rem;
    color: var(--accent);
  }
  .areas,
  .tech {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .areas + .tech {
    margin-top: var(--space-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .actions .btn {
    min-height: 44px;
  }
  .soon {
    margin: var(--space-3) 0 0;
  }
  .soon-label {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    color: var(--text-muted);
    border: 1px dashed var(--border-strong);
  }
  .case-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-top: var(--space-2);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--accent);
    text-decoration: none;
  }
  .case-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  @media (max-width: 899px) {
    .pcard {
      grid-template-columns: minmax(0, 1fr);
    }
    .pcard[data-flip='true'] .media {
      order: 0;
    }
  }
  @media (max-width: 639px) {
    .pcard {
      padding: var(--space-4);
    }
  }
</style>
