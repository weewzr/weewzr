---
/**
 * Site footer: name and identity line, the sections in the same labelled groups as the top navigation,
 * outside links, and the credit and licence line.
 */
import { site, social, sections, mascot } from '../data/site';
import { withBase } from '../lib/url';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const creditsUrl = `${social.github}/weewzr/blob/main/docs/CREDITS.md`;
const built = [
  { label: 'Astro', href: 'https://astro.build' },
  { label: 'Tailwind CSS', href: 'https://tailwindcss.com' },
] as const;
const pick = (ids: string[]) => sections.filter((s) => ids.includes(s.id));
const groups = [
  { label: 'Work', items: pick(['projects', 'research', 'writing']) },
  { label: 'Beyond the lab', items: pick(['community', 'innovation']) },
  { label: 'Profile', items: pick(['about']) },
];
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__brand">
      <a class="footer__name" href={withBase('')}>{site.name}</a>
      <p class="footer__identity">{site.identity}</p>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      {
        groups.map((g) => (
          <div class="footer__col">
            <p class="footer__label">{g.label}</p>
            <ul class="footer__list">
              {g.items.map((item) => (
                <li>
                  <a class="footer__link" href={withBase(item.path)}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="footer__col">
        <p class="footer__label">Elsewhere</p>
        <ul class="footer__list">
          <li>
            <a class="footer__link" href={social.github} target="_blank" rel="noopener noreferrer">
              <Icon name="github" size={16} />
              GitHub
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a class="footer__link" href={social.linkedin} target="_blank" rel="noopener noreferrer">
              <Icon name="linkedin" size={16} />
              LinkedIn
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </li>
          {
            social.email && (
              <li>
                <a class="footer__link" href={withBase('about/#contact')}>
                  <Icon name="mail" size={16} />
                  Email (see Contact)
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </nav>

    <div class="footer__legal">
      {mascot.enabled && <p class="footer__credit">{mascot.credit}</p>}
      <p class="footer__meta">
        <span>&copy; {year} {site.name}</span>
        <span class="footer__dot" aria-hidden="true">&middot;</span>
        <span>
          Built with{' '}
          <a href={built[0].href} target="_blank" rel="noopener noreferrer">
            {built[0].label}
          </a>{' '}
          and{' '}
          <a href={built[1].href} target="_blank" rel="noopener noreferrer">
            {built[1].label}
          </a>
        </span>
        <span class="footer__dot" aria-hidden="true">&middot;</span>
        <a href={creditsUrl} target="_blank" rel="noopener noreferrer">Credits and licences</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-7) var(--space-6);
    background: var(--bg-subtle);
    border-top: 1px solid var(--border);
  }
  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }
  .footer__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    color: var(--text);
    text-decoration: none;
  }
  .footer__name:hover {
    text-decoration: underline;
  }
  .footer__identity {
    margin-top: var(--space-2);
    max-width: 44ch;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--text-muted);
  }
  .footer__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }
  @media (min-width: 768px) {
    .footer__nav {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .footer__label {
    margin-bottom: var(--space-1);
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--text-muted);
  }
  .footer__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-min);
    font-size: var(--fs-small);
    color: var(--text);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--ease);
  }
  .footer__link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .footer__legal {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    font-size: var(--fs-label);
    line-height: 1.6;
    color: var(--text-muted);
  }
  .footer__credit {
    max-width: var(--measure);
  }
  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-2);
    margin: 0;
  }
  .footer__meta a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
  }
  .footer__meta a:hover {
    color: var(--accent);
  }
  @media (min-width: 1024px) {
    .footer__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      column-gap: var(--space-7);
    }
    .footer__legal {
      grid-column: 1 / -1;
    }
  }
</style>
