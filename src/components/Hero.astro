---
/**
 * Home hero. Text comes from site.ts. <PerryHero /> positions itself absolutely in the bottom-right corner of
 * this section: the copy leaves room on wide screens (--perry-w) and the section pads its bottom edge on narrow
 * ones (--perry-h), so the figure sits to the right or below the text.
 */
import { site, social, education } from '../data/site';
import Icon from './Icon.astro';
import { withBase } from '../lib/url';
import PerryHero from './PerryHero.astro';

// "Chemical Engineering @ NUS": the abbreviation is read from the bracketed part of the institution name.
const abbreviation = education.institution.match(/\(([^)]+)\)/)?.[1] ?? education.institution;
const eyebrow = `${education.degree} @ ${abbreviation}`;
const identityParts = site.identity.split(' | ').filter((part) => part !== eyebrow);
---

<section id="hero" class="hero section" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__content">
      <p class="eyebrow hero__eyebrow">{eyebrow}</p>
      <h1 id="hero-title" class="hero__name">{site.name}</h1>
      <p class="hero__headline">{site.headline}</p>
      <p class="hero__subtitle">{site.subtitle}</p>
      <p class="hero__identity">
        {
          identityParts.map((part, index) => (
            <>
              {index > 0 && (
                <span class="hero__sep" aria-hidden="true">
                  {' · '}
                </span>
              )}
              <span class="hero__part">{part}</span>
            </>
          ))
        }
      </p>
      <div class="hero__actions">
        <a class="btn btn-primary" href={withBase('projects/')}>
          View projects
          <Icon name="arrow-right" size={20} />
        </a>
        <a class="btn" href={withBase('about/')}>About me</a>
        <span class="hero__links">
          <a
            class="hero__icon"
            href={social.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub profile, opens in a new tab"
          >
            <Icon name="github" size={20} />
          </a>
          <a
            class="hero__icon"
            href={social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn profile, opens in a new tab"
          >
            <Icon name="linkedin" size={20} />
          </a>
        </span>
      </div>
    </div>
  </div>

  <PerryHero />
</section>

<style>
  .hero {
    /* Space kept free for <PerryHero /> in the bottom-right corner. */
    --perry-w: 320px;
    --perry-h: 360px;
    position: relative;
    padding-block: var(--space-7) var(--space-7);
  }
  .hero__inner {
    position: relative;
  }
  .hero__content {
    max-width: 46rem;
  }
  .hero__eyebrow {
    margin: 0;
  }
  .hero__name {
    margin-top: var(--space-2);
    font-size: var(--fs-page-title);
    color: var(--text);
  }
  .hero__headline {
    margin-top: var(--space-3);
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--text);
  }
  .hero__subtitle {
    margin-top: var(--space-3);
    max-width: 68ch;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--text-muted);
  }
  .hero__identity {
    margin-top: var(--space-4);
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--text-muted);
  }
  .hero__part {
    white-space: nowrap;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .hero__links {
    display: inline-flex;
    gap: var(--space-2);
    margin-left: var(--space-1);
  }
  .hero__icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    color: var(--text);
    border: 1px solid var(--border-strong);
    transition:
      color var(--ease),
      background-color var(--ease),
      border-color var(--ease);
  }
  .hero__icon:hover {
    color: var(--text);
    border-color: var(--text);
    background: var(--bg-subtle);
  }

  /* Wide screens: the copy column stays clear of the Perry corner. */
  @media (min-width: 900px) {
    .hero__content {
      max-width: min(46rem, calc(100% - var(--perry-w) - var(--space-5)));
    }
  }

  /* Tablet and phone: Perry sits below the copy, so reserve space at the bottom. */
  @media (max-width: 899.98px) {
    .hero {
      /* PerryHero is clamp(150px, 22vw, 300px) wide here and about 1.1 times as tall. */
      --perry-w: clamp(150px, 22vw, 300px);
      --perry-h: calc(var(--perry-w) * 1.12);
      padding-bottom: calc(var(--perry-h) + var(--space-4));
    }
  }
  @media (max-width: 639.98px) {
    .hero {
      /* PerryHero is 92px wide under 640px. */
      --perry-w: 92px;
      --perry-h: 104px;
    }
    .hero__part {
      white-space: normal;
    }
    .hero__links {
      margin-left: 0;
    }
  }
</style>
