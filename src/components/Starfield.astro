---
/**
 * Cosmic background, rendered once by BaseLayout before the Nav.
 *
 * Layers, back to front:
 *   1. nebula      large soft radial gradients, transform-only drift (60 to 120 s)
 *   2. streaks     a few long, thin purple ribbons that flow slowly
 *   3. stars       tiled SVG star fields (build-time, seeded), gentle CSS twinkle
 *   4. canvas      Three.js points, created lazily by the script below (src/scripts/starfield.ts)
 *   5. shooters    one short-lived DOM streak at a time, every 14 to 28 s
 *
 * Layers 1 to 3 are the no-WebGL, no-JS and reduced-motion fallback and already look finished.
 * html carries the base colour and body is transparent, so z-index -1 stays visible.
 */
interface Tier {
  size: number;
  count: number;
  rMin: number;
  rMax: number;
  oMin: number;
  oMax: number;
  gap: number;
  seed: number;
  halo?: boolean;
}

/** Small deterministic PRNG: the same sky on every build. */
function prng(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const TONES = ['#e8eeff', '#b3cdff', '#d2c4ff']; // white, pale blue, lavender

/** One seamless star tile as an SVG data URI inside an inline style. */
function starTile(t: Tier): string {
  const rnd = prng(t.seed);
  const margin = t.halo ? 8 : 3;
  const pts: Array<[number, number]> = [];
  let tries = 0;
  while (pts.length < t.count && tries++ < t.count * 80) {
    const x = Math.round(margin + rnd() * (t.size - 2 * margin));
    const y = Math.round(margin + rnd() * (t.size - 2 * margin));
    const clear = pts.every(([px, py]) => {
      const dx = Math.min(Math.abs(px - x), t.size - Math.abs(px - x));
      const dy = Math.min(Math.abs(py - y), t.size - Math.abs(py - y));
      return dx * dx + dy * dy >= t.gap * t.gap;
    });
    if (clear) pts.push([x, y]);
  }
  const buckets: string[][] = TONES.map(() => []);
  for (const [x, y] of pts) {
    const pick = rnd();
    const bucket = buckets[pick < 0.55 ? 0 : pick < 0.8 ? 1 : 2]!;
    const r = t.rMin + rnd() * (t.rMax - t.rMin);
    const o = t.oMin + rnd() * (t.oMax - t.oMin);
    if (t.halo) bucket.push(`<circle cx="${x}" cy="${y}" r="${(r * 3.6).toFixed(1)}" fill="url(#h)"/>`);
    bucket.push(`<circle cx="${x}" cy="${y}" r="${r.toFixed(2)}" opacity="${o.toFixed(2)}"/>`);
  }
  const groups = buckets.map((b, i) => `<g fill="${TONES[i]}">${b.join('')}</g>`).join('');
  const defs = t.halo
    ? '<defs><radialGradient id="h"><stop offset="0" stop-color="#d2c4ff" stop-opacity=".3"/><stop offset="1" stop-color="#d2c4ff" stop-opacity="0"/></radialGradient></defs>'
    : '';
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${t.size}" height="${t.size}">${defs}${groups}</svg>`;
  return `background-image:url("data:image/svg+xml,${encodeURIComponent(svg)}");background-size:${t.size}px ${t.size}px`;
}

// Tile sizes are unrelated primes-ish so the three repeats never line up.
const far = starTile({ size: 331, count: 20, rMin: 0.6, rMax: 0.9, oMin: 0.45, oMax: 0.8, gap: 40, seed: 11 });
const mid = starTile({ size: 479, count: 11, rMin: 0.85, rMax: 1.2, oMin: 0.6, oMax: 0.95, gap: 70, seed: 23 });
const near = starTile({ size: 701, count: 5, rMin: 1.25, rMax: 1.7, oMin: 0.8, oMax: 1, gap: 140, seed: 37, halo: true });
---

<div class="cosmos" aria-hidden="true">
  <div class="cosmos-layer cosmos-nebula">
    <span class="cosmos-neb n1"></span>
    <span class="cosmos-neb n2"></span>
    <span class="cosmos-neb n3"></span>
    <span class="cosmos-neb n4"></span>
    <span class="cosmos-neb n5"></span>
  </div>
  <div class="cosmos-layer cosmos-streaks">
    <span class="cosmos-streak k1"></span>
    <span class="cosmos-streak k2"></span>
    <span class="cosmos-streak k3"></span>
  </div>
  <div class="cosmos-layer cosmos-stars">
    <div class="cosmos-tier t-far" style={far}></div>
    <div class="cosmos-tier t-mid" style={mid}></div>
    <div class="cosmos-tier t-near" style={near}></div>
  </div>
  <div class="cosmos-layer cosmos-shooters"></div>
</div>

<style>
  .cosmos {
    position: fixed;
    inset: 0;
    /* lvh keeps the box (and the canvas inside it) stable while mobile browser bars show and hide. */
    height: 100vh;
    height: 100lvh;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
    user-select: none;
    background:
      radial-gradient(120% 70% at 50% -8%, rgb(11 27 58 / 0.9), transparent 62%),
      radial-gradient(90% 60% at 50% 125%, rgb(26 16 62 / 0.55), transparent 70%);
  }
  .cosmos-layer {
    position: absolute;
    inset: 0;
  }

  /* ---- 1. Nebula ---------------------------------------------------------------------- */
  .cosmos-neb {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    height: var(--s);
    background: radial-gradient(
      closest-side,
      rgb(var(--c) / var(--a)) 0%,
      rgb(var(--c) / calc(var(--a) * 0.62)) 26%,
      rgb(var(--c) / calc(var(--a) * 0.3)) 52%,
      rgb(var(--c) / calc(var(--a) * 0.09)) 78%,
      rgb(var(--c) / 0) 100%
    );
    animation: cs-drift var(--t) ease-in-out var(--dl, 0s) infinite alternate;
  }
  .n1 {
    --c: 124 58 237;
    --a: 0.3;
    --s: 78vmax;
    --x: -24%;
    --y: -30vmax;
    --t: 96s;
    --dx: 9vmax;
    --dy: 6vmax;
    --sc: 1.1;
  }
  .n2 {
    --c: 37 99 235;
    --a: 0.27;
    --s: 80vmax;
    --x: 46%;
    --y: -6vmax;
    --t: 118s;
    --dl: -40s;
    --dx: -8vmax;
    --dy: 7vmax;
    --sc: 1.08;
  }
  .n3 {
    --c: 167 139 250;
    --a: 0.15;
    --s: 62vmax;
    --x: -18%;
    --y: 46%;
    --t: 74s;
    --dl: -20s;
    --dx: 8vmax;
    --dy: -5vmax;
    --sc: 1.12;
  }
  .n4 {
    --c: 109 56 226;
    --a: 0.22;
    --s: 66vmax;
    --x: 32%;
    --y: 62%;
    --t: 104s;
    --dl: -60s;
    --dx: -7vmax;
    --dy: -6vmax;
    --sc: 1.06;
  }
  .n5 {
    --c: 59 130 246;
    --a: 0.14;
    --s: 46vmax;
    --x: 62%;
    --y: -14vmax;
    --t: 66s;
    --dl: -10s;
    --dx: -5vmax;
    --dy: 5vmax;
    --sc: 1.14;
  }
  @keyframes cs-drift {
    to {
      transform: translate3d(var(--dx), var(--dy), 0) scale(var(--sc));
    }
  }

  /* ---- 2. Streaks --------------------------------------------------------------------- */
  .cosmos-streak {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
    rotate: var(--r);
    opacity: var(--o);
    background: radial-gradient(
      closest-side,
      rgb(124 58 237 / 0.2),
      rgb(124 58 237 / 0.09) 45%,
      rgb(124 58 237 / 0) 100%
    );
    animation: cs-flow var(--t) ease-in-out var(--dl, 0s) infinite alternate;
  }
  .cosmos-streak::after {
    content: '';
    position: absolute;
    left: 6%;
    right: 6%;
    top: 50%;
    height: 1.5px;
    margin-top: -0.75px;
    background: linear-gradient(
      90deg,
      rgb(167 139 250 / 0),
      rgb(167 139 250 / 0.22) 30%,
      rgb(196 181 253 / 0.28) 58%,
      rgb(167 139 250 / 0)
    );
    filter: blur(0.8px);
  }
  .k1 {
    --x: -30vmax;
    --y: 14%;
    --w: 150vmax;
    --h: 120px;
    --r: -23deg;
    --o: 0.85;
    --t: 84s;
    --fx: 14vmax;
  }
  .k2 {
    --x: -10vmax;
    --y: 58%;
    --w: 130vmax;
    --h: 90px;
    --r: -17deg;
    --o: 0.65;
    --t: 108s;
    --dl: -50s;
    --fx: -12vmax;
  }
  .k3 {
    --x: -40vmax;
    --y: 84%;
    --w: 120vmax;
    --h: 80px;
    --r: -29deg;
    --o: 0.5;
    --t: 72s;
    --dl: -25s;
    --fx: 10vmax;
  }
  @keyframes cs-flow {
    to {
      transform: translate3d(var(--fx), 0, 0);
    }
  }

  /* ---- 3. Static stars ---------------------------------------------------------------- */
  .cosmos-stars {
    transition: opacity 1.8s ease;
  }
  .cosmos-tier {
    position: absolute;
    inset: 0;
    background-repeat: repeat;
  }
  .t-far {
    animation: cs-twinkle-a 9s ease-in-out infinite alternate;
  }
  .t-mid {
    animation: cs-twinkle-b 13s ease-in-out -4s infinite alternate;
  }
  @keyframes cs-twinkle-a {
    from {
      opacity: 0.62;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes cs-twinkle-b {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.6;
    }
  }

  /* ---- 4. WebGL canvas (created by the script) ---------------------------------------- */
  .cosmos :global(.cosmos-gl) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.8s ease;
  }
  .cosmos.has-gl :global(.cosmos-gl) {
    opacity: 1;
  }
  /* With real stars on screen, the CSS field steps back so the sky does not get crowded. */
  .cosmos.has-gl .cosmos-stars {
    opacity: 0.5;
  }

  /* ---- 5. Shooting stars (created by the script) -------------------------------------- */
  .cosmos-shooters :global(.cosmos-shoot) {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 150px;
    height: 1.5px;
    border-radius: 2px;
    rotate: var(--a);
    transform-origin: 100% 50%;
    opacity: 0;
    background: linear-gradient(
      90deg,
      rgb(167 139 250 / 0),
      rgb(196 181 253 / 0.35) 62%,
      rgb(240 244 255 / 0.9)
    );
    box-shadow: 0 0 8px rgb(167 139 250 / 0.35);
    animation: cs-shoot 1.7s cubic-bezier(0.25, 0.6, 0.4, 1) forwards;
  }
  @keyframes cs-shoot {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) scaleX(0.5);
    }
    14% {
      opacity: 0.85;
    }
    100% {
      opacity: 0;
      transform: translate3d(var(--d), 0, 0) scaleX(1);
    }
  }
  @media (max-width: 767.98px) {
    .cosmos-shooters :global(.cosmos-shoot) {
      width: 100px;
    }
  }

  /* ---- Preferences and media ---------------------------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .cosmos-neb,
    .cosmos-streak,
    .cosmos-tier {
      animation: none;
    }
    .cosmos-shooters {
      display: none;
    }
  }
  @media (forced-colors: active), print {
    .cosmos {
      display: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.cosmos');
  const field = root?.querySelector<HTMLElement>('.cosmos-shooters') ?? null;

  if (root && field) {
    const reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const rand = (min: number, max: number): number => min + Math.random() * (max - min);
    let alive = true;

    // ---- Shooting stars: CSS-animated DOM element, one at a time, 14 to 28 s apart --------
    let shootTimer = 0;
    let cleanTimer = 0;
    let shootEl: HTMLElement | null = null;

    const clearShoot = (): void => {
      window.clearTimeout(shootTimer);
      window.clearTimeout(cleanTimer);
      shootEl?.remove();
      shootEl = null;
    };
    const canShoot = (): boolean => alive && !reduceQuery.matches && !document.hidden;
    /** Next streak 14 to 28 s from now; each one lasts under 2 s, so never two at once. */
    const scheduleShoot = (): void => {
      window.clearTimeout(shootTimer);
      if (canShoot()) shootTimer = window.setTimeout(fireShoot, rand(14000, 28000));
    };
    function fireShoot(): void {
      scheduleShoot();
      if (!canShoot() || shootEl) return;
      const ltr = Math.random() < 0.5;
      const el = document.createElement('i');
      el.className = 'cosmos-shoot';
      el.style.setProperty('--x', `${ltr ? rand(6, 60) : rand(40, 94)}%`);
      el.style.setProperty('--y', `${rand(5, 42)}%`);
      el.style.setProperty('--a', `${ltr ? rand(16, 34) : rand(146, 164)}deg`);
      el.style.setProperty('--d', `${rand(300, 460)}px`);
      field!.append(el);
      shootEl = el;
      cleanTimer = window.setTimeout(() => {
        el.remove();
        shootEl = null;
      }, 2000);
    }

    // ---- Three.js stars: loaded lazily, skipped when WebGL2 is unavailable ---------------
    interface StarsHandle {
      dispose(): void;
    }
    let stars: StarsHandle | null = null;
    let mounting = false;

    const release = (gl: WebGL2RenderingContext | null): void => {
      gl?.getExtension('WEBGL_lose_context')?.loseContext();
    };

    async function mountGL(): Promise<void> {
      if (stars || mounting || !alive) return;
      // Respect Save-Data: the CSS layers already carry the look and skip the ~130 kB gzip download.
      const link = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
      if (link?.saveData) return;
      mounting = true;
      const canvas = document.createElement('canvas');
      canvas.className = 'cosmos-gl';
      let gl: WebGL2RenderingContext | null = null;
      try {
        gl = canvas.getContext('webgl2', {
          alpha: true,
          antialias: false,
          depth: false,
          stencil: false,
          premultipliedAlpha: true,
          powerPreference: 'low-power',
        });
        if (!gl) return; // no WebGL2: the CSS layers stay as they are
        const mod = await import('../scripts/starfield');
        if (!alive) {
          release(gl);
          return;
        }
        root!.insertBefore(canvas, field);
        stars = mod.mountStars({ host: root!, canvas, gl });
      } catch {
        canvas.remove();
        release(gl);
        stars = null;
      } finally {
        mounting = false;
      }
    }

    const whenIdle = (fn: () => void): void => {
      if (typeof window.requestIdleCallback === 'function') window.requestIdleCallback(fn, { timeout: 3000 });
      else window.setTimeout(fn, 1500);
    };
    const boot = (): void => whenIdle(() => void mountGL());

    // ---- Lifecycle -------------------------------------------------------------------------
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) clearShoot();
      else scheduleShoot();
    });
    reduceQuery.addEventListener('change', () => {
      if (reduceQuery.matches) clearShoot();
      else scheduleShoot();
    });
    window.addEventListener('pagehide', () => {
      alive = false;
      clearShoot();
      stars?.dispose();
      stars = null;
    });
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      alive = true;
      boot();
      scheduleShoot();
    });

    if (document.readyState === 'complete') boot();
    else window.addEventListener('load', boot, { once: true });
    scheduleShoot();
  }
</script>
