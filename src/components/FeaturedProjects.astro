---
/**
 * The project list. Loops over `projects` in src/data/site.ts, so adding a project there (plus a preview image
 * under public/projects) needs no change here.
 * Props:
 *   showHead      draw the block header (home page). The projects index page has its own page hero.
 *   filter        show the research-area filter (projects index page)
 *   headingLevel  heading element for the project titles ('h3' under a block h2, 'h2' under a page h1)
 *   variant       'row' (home: one sentence and one checked result) or 'full' (projects page)
 *   id            section id (home keeps "projects" for old links)
 */
import ProjectCard from './ProjectCard.astro';
import { projects, researchInterests } from '../data/site';
import { withBase } from '../lib/url';
import Icon from './Icon.astro';
import PerryImage from './PerryImage.astro';

interface Props {
  showHead?: boolean;
  filter?: boolean;
  headingLevel?: 'h2' | 'h3';
  variant?: 'row' | 'full';
  id?: string;
}
const { showHead = false, filter = false, headingLevel = 'h3', variant = 'row', id } = Astro.props;

// Chips come from the research areas that at least one project uses, in researchInterests order.
const areaChips = researchInterests.filter((area) => projects.some((p) => p.areas.includes(area.id)));
---

<section
  id={id}
  class:list={['projects-block', showHead ? 'section projects-block--home' : 'block']}
  aria-labelledby={showHead ? 'projects-title' : undefined}
  aria-label={showHead ? undefined : 'Projects'}
>
  <div class="container">
    {
      showHead && (
        <header class="section-head">
          <div class="section-head__text">
            <h2 id="projects-title" class="section-title">Projects</h2>
            <p class="section-lead">
              Four open models. Each row shows the project's own figure and one checked result, with the kind of check
              and where it is recorded.
            </p>
          </div>
          <div class="section-head__aside">
            <figure class="projects-perry">
              <PerryImage slot="projects" />
            </figure>
            <a class="link-arrow" href={withBase('projects/')}>
              All projects, by research area
              <Icon name="arrow-right" size={20} />
            </a>
          </div>
        </header>
      )
    }

    {
      filter && areaChips.length > 1 && (
        <div class="proj-filter" data-project-filter>
          <p class="proj-filter__label" id="proj-filter-label">
            Filter by research area
          </p>
          <div class="chips" role="group" aria-labelledby="proj-filter-label">
            <button type="button" class="filter-chip" data-area="all" aria-pressed="true">
              All projects
              <span class="filter-chip__count">{projects.length}</span>
            </button>
            {areaChips.map((area) => (
              <button type="button" class="filter-chip" data-area={area.id} data-label={area.short} aria-pressed="false">
                {area.short}
                <span class="filter-chip__count">{projects.filter((p) => p.areas.includes(area.id)).length}</span>
              </button>
            ))}
          </div>
          <p class="filter-status" role="status" data-filter-status>
            Showing all {projects.length} projects.
          </p>
        </div>
      )
    }

    <ol class="project-list" role="list" data-project-list>
      {
        projects.map((project, i) => (
          <li data-areas={project.areas.join(' ')}>
            <ProjectCard project={project} headingLevel={headingLevel} variant={variant} eager={i === 0} />
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Agent P crouching above the link to all projects, as on the original site (owner's choice). */
  .section-head__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
  }
  .projects-perry {
    margin: 0;
    width: clamp(88px, 8vw, 116px);
  }
  .projects-perry :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 719px) {
    .section-head__aside {
      align-items: flex-start;
    }
    .projects-perry {
      width: 84px;
    }
  }

  .projects-block--home {
    padding-block: var(--space-6);
  }
  /* Home: a one-line lead and a tighter head, so the first project row stays above the fold at 1440 x 900. */
  .projects-block--home .section-head {
    margin-bottom: var(--space-4);
  }
  .projects-block--home .section-lead {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
  }
  @media (min-width: 1024px) {
    .projects-block--home .section-head__text {
      display: flex;
      align-items: baseline;
      gap: var(--space-5);
    }
    .projects-block--home .section-lead {
      margin-top: 0;
    }
  }
  .projects-block--home .project-list > li:first-child :global(.prow) {
    padding-top: var(--space-5);
  }
  /* The filter needs JavaScript, so it stays hidden until the `js` class from BaseLayout is present. */
  .proj-filter {
    display: none;
    margin: 0 0 var(--space-5);
  }
  :global(.js) .proj-filter {
    display: block;
  }
  .proj-filter__label {
    margin-bottom: var(--space-2);
    font-size: var(--fs-label);
    font-weight: 500;
    color: var(--text-muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-min);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--text);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    cursor: pointer;
    transition:
      background-color var(--ease),
      border-color var(--ease),
      color var(--ease);
  }
  .filter-chip:hover {
    border-color: var(--text);
    background: var(--bg-subtle);
  }
  .filter-chip[aria-pressed='true'] {
    color: var(--accent);
    background: var(--accent-bg);
    border-color: var(--accent);
    font-weight: 600;
  }
  .filter-chip__count {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-muted);
  }
  .filter-chip[aria-pressed='true'] .filter-chip__count {
    color: var(--accent);
  }
  .filter-status {
    min-height: 1.5em;
    margin: var(--space-2) 0 0;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--border);
  }
  .project-list > li[hidden] {
    display: none;
  }
</style>

<script>
  // Project filter by research area. The list is complete HTML; this only hides non-matching items and says
  // how many remain.
  const root = document.querySelector<HTMLElement>('[data-project-filter]');
  const list = document.querySelector<HTMLElement>('[data-project-list]');
  if (root && list) {
    const items = Array.from(list.children) as HTMLElement[];
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-area]'));
    const status = root.querySelector<HTMLElement>('[data-filter-status]');

    const apply = (area: string, label: string) => {
      let shown = 0;
      for (const item of items) {
        const match = area === 'all' || (item.dataset.areas ?? '').split(' ').includes(area);
        item.hidden = !match;
        if (match) shown += 1;
      }
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.area === area));
      if (status) {
        status.textContent =
          area === 'all'
            ? `Showing all ${items.length} projects.`
            : `Showing ${shown} of ${items.length} projects in ${label}.`;
      }
    };

    for (const b of buttons) {
      b.addEventListener('click', () => apply(b.dataset.area ?? 'all', b.dataset.label ?? ''));
    }
  }
</script>
