---
/**
 * Engineering projects. Loops over `projects` in src/data/site.ts, so adding a project there (plus a preview image
 * under public/projects) needs no change here.
 * Props:
 *   showHead   draw the block header with the Perry mascot (home page). The projects index page has its own page hero.
 *   filter     show the research-area filter chips (projects index page)
 *   headingLevel  heading element for the card titles ('h3' under a block h2, 'h2' under a page h1)
 *   id         section id (home keeps "projects" for old links)
 */
import ProjectCard from './ProjectCard.astro';
import PerryAgent from './PerryAgent.astro';
import { projects, researchInterests, sections } from '../data/site';
import { withBase } from '../lib/url';
import Icon from './Icon.astro';

interface Props {
  showHead?: boolean;
  filter?: boolean;
  headingLevel?: 'h2' | 'h3';
  id?: string;
}
const { showHead = false, filter = false, headingLevel = 'h3', id } = Astro.props;
const section = sections.find((s) => s.id === 'projects');

// Chips come from the research areas that at least one project uses, in researchInterests order.
// Adding a project (with its `areas` ids) in src/data/site.ts needs no change here.
const areaChips = researchInterests.filter((area) => projects.some((p) => p.areas.includes(area.id)));
---

<section id={id} class:list={['projects-block', { section: showHead, block: !showHead }]} aria-labelledby={showHead ? 'projects-title' : undefined} aria-label={showHead ? undefined : 'Projects'}>
  <div class="container">
    {
      showHead && (
        <header class="proj-head reveal">
          <p class="eyebrow">Engineering projects</p>
          <h2 id="projects-title" class="section-title">Featured engineering projects</h2>
          <p class="section-lead">{section?.lead}</p>
          <PerryAgent />
        </header>
      )
    }

    {
      filter && areaChips.length > 1 && (
        <div class="proj-filter" data-project-filter>
          <div class="chips" role="group" aria-label="Filter projects by research area">
            <button type="button" class="filter-chip" data-area="all" aria-pressed="true">
              All projects
            </button>
            {areaChips.map((area) => (
              <button type="button" class="filter-chip" data-area={area.id} data-label={area.short} aria-pressed="false">
                {area.short}
              </button>
            ))}
          </div>
          <p class="filter-status" role="status" data-filter-status />
        </div>
      )
    }

    <ol class="project-list" role="list" data-project-list>
      {
        projects.map((project, i) => (
          <li class="reveal" style={`--i:${i}`} data-areas={project.areas.join(' ')}>
            <ProjectCard project={project} index={i} headingLevel={headingLevel} />
          </li>
        ))
      }
    </ol>

    {
      showHead && (
        <p class="proj-more reveal">
          <a class="link-arrow" href={withBase('projects/')}>
            All projects, with filters by research area
            <Icon name="arrow-right" size={18} />
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .proj-head {
    position: relative;
    margin-bottom: clamp(2rem, 5vw, 3.25rem);
  }
  /* From 900px PerryAgent is absolute in the top-right corner (width clamp(120px, 11vw, 150px), about 0.8 of that
     in height). Reserve that corner so the text never runs underneath it. Below 900px Perry sits in the flow. */
  @media (min-width: 900px) {
    .proj-head {
      padding-right: calc(clamp(120px, 11vw, 150px) + 1.5rem);
      min-height: 9rem;
    }
  }
  /* The filter needs JavaScript, so it stays hidden until the `js` class from BaseLayout is present. */
  .proj-filter {
    display: none;
    margin: 0 0 clamp(1.5rem, 4vw, 2.25rem);
  }
  :global(.js) .proj-filter {
    display: block;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filter-chip {
    min-height: 44px;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    border: 1px solid rgb(148 163 184 / 0.3);
    background: rgb(11 27 58 / 0.55);
    color: #cbd5e1;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .filter-chip:hover {
    border-color: rgb(167 139 250 / 0.6);
    color: #fff;
  }
  .filter-chip[aria-pressed='true'] {
    color: #fff;
    background: rgb(124 58 237 / 0.3);
    border-color: rgb(167 139 250 / 0.6);
  }
  .filter-status {
    min-height: 1.5em;
    margin: 0.6rem 0 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
  }
  .project-list > li[hidden] {
    display: none;
  }
  .proj-more {
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }
</style>

<script>
  // Project filter by research area. The list is complete HTML; this only hides non-matching items.
  const root = document.querySelector<HTMLElement>('[data-project-filter]');
  const list = document.querySelector<HTMLElement>('[data-project-list]');
  if (root && list) {
    const items = Array.from(list.children) as HTMLElement[];
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-area]'));
    const status = root.querySelector<HTMLElement>('[data-filter-status]');

    const apply = (area: string, label: string) => {
      let shown = 0;
      for (const item of items) {
        const match = area === 'all' || (item.dataset.areas ?? '').split(' ').includes(area);
        item.hidden = !match;
        if (match) {
          // Keep the left/right image alternation correct for the cards that remain.
          item.querySelector('.pcard')?.setAttribute('data-flip', shown % 2 === 1 ? 'true' : 'false');
          shown += 1;
        }
      }
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.area === area));
      if (status) {
        status.textContent =
          area === 'all' ? '' : `Showing ${shown} of ${items.length} projects in ${label}.`;
      }
    };

    for (const b of buttons) {
      b.addEventListener('click', () => apply(b.dataset.area ?? 'all', b.dataset.label ?? ''));
    }
  }
</script>
