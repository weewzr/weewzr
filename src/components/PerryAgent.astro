---
/**
 * Agent P inspecting the Featured Projects section.
 * At 900px and wider: absolute at the top-right of the nearest positioned ancestor
 * (the projects section header container). Below that: a small static element in the flow.
 * The mascot is a focusable button, its speech bubble is its description (tooltip).
 */
import { mascot } from '../data/site';
import PerryImage from './PerryImage.astro';

const enabled = mascot.enabled;
const Trigger = enabled ? 'button' : 'div';
const triggerProps = enabled
  ? { type: 'button' as const, 'data-perry-trigger': '', 'aria-describedby': 'perry-agent-bubble' }
  : {};
---

<div class="perry-agent" data-perry-talk={enabled ? '' : undefined}>
  <Trigger class="perry-agent__btn" {...triggerProps}>
    <span class="perry-agent__lean">
      <PerryImage slot="projects" class="perry-agent__img" />
    </span>
  </Trigger>
  {
    enabled && (
      <span class="perry-bubble perry-agent__bubble" id="perry-agent-bubble" role="tooltip">
        {mascot.lines.projects}
      </span>
    )
  }
</div>

<style>
  /* Narrow screens: small, static, right-aligned on its own row. */
  .perry-agent {
    position: relative;
    display: flex;
    justify-content: flex-end;
    margin-top: 0.75rem;
    pointer-events: none;
  }
  .perry-agent__btn {
    appearance: none;
    display: block;
    width: 96px;
    min-height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
    border-radius: 14px;
  }
  div.perry-agent__btn {
    cursor: default;
  }
  .perry-agent__btn:focus-visible {
    outline: 2px solid var(--lavender);
    outline-offset: 4px;
  }
  .perry-agent__lean {
    display: block;
    transform-origin: 20% 100%;
  }
  .perry-agent :global(.perry-agent__img) {
    width: 100%;
    filter: drop-shadow(0 8px 14px rgb(2 6 23 / 0.5));
  }
  /* Beside the small mascot, in the empty part of its own row. */
  .perry-agent__bubble {
    right: calc(96px + 0.9rem);
    top: 50%;
    margin-top: -1.1rem;
  }
  .perry-agent__bubble::after {
    /* tail points right, towards Perry */
    right: -6px;
    top: calc(50% - 5px);
    border-width: 1px 1px 0 0;
  }

  @media (min-width: 900px) {
    .perry-agent {
      position: absolute;
      top: 0;
      right: 0;
      display: block;
      margin: 0;
      width: clamp(120px, 11vw, 150px);
    }
    .perry-agent__btn {
      width: 100%;
    }
    /* Above the header, in the section padding, so it never covers a title, a lead or a card. */
    .perry-agent__bubble {
      right: 0;
      top: auto;
      bottom: calc(100% + 0.6rem);
      margin-top: 0;
    }
    .perry-agent__bubble::after {
      right: 1.1rem;
      top: auto;
      bottom: -6px;
      border-width: 0 1px 1px 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .perry-agent__lean {
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
      animation: perry-agent-idle 6.5s ease-in-out infinite;
    }
    .perry-agent__btn:is(:hover, :focus-visible) .perry-agent__lean {
      animation: perry-agent-lean 0.6s ease-out forwards;
    }
    .perry-agent.is-talking .perry-agent__lean {
      animation: perry-agent-lean 0.6s ease-out forwards;
    }
  }

  @keyframes perry-agent-idle {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-3px) rotate(-0.8deg);
    }
  }
  /* Lean in towards the cards and tip the hat. */
  @keyframes perry-agent-lean {
    0% {
      transform: translateY(0) rotate(0deg);
    }
    45% {
      transform: translate(-3px, 2px) rotate(-5deg);
    }
    100% {
      transform: translate(-2px, 1px) rotate(-3deg);
    }
  }
</style>
