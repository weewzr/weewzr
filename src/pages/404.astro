---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Page not found" description="The page you asked for does not exist on this site." noindex>
  <section class="lost" aria-labelledby="lost-title">
    <div class="container lost-inner">
      <div class="orbit" aria-hidden="true">
        <svg viewBox="0 0 240 240" width="240" height="240" focusable="false">
          <defs>
            <linearGradient id="lost-ring" x1="20" y1="220" x2="220" y2="20" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#3B82F6"></stop>
              <stop offset="0.55" stop-color="#7C3AED"></stop>
              <stop offset="1" stop-color="#A78BFA"></stop>
            </linearGradient>
            <radialGradient id="lost-glow" cx="120" cy="120" r="90" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#3B82F6" stop-opacity="0.45"></stop>
              <stop offset="1" stop-color="#3B82F6" stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <circle cx="120" cy="120" r="90" fill="url(#lost-glow)"></circle>
          <g transform="rotate(-24 120 120)">
            <ellipse cx="120" cy="120" rx="108" ry="36" fill="none" stroke="url(#lost-ring)" stroke-width="3" opacity="0.9"></ellipse>
            <circle cx="222" cy="108.2" r="7" fill="#A78BFA"></circle>
          </g>
          <path d="M120 62 L129 111 L178 120 L129 129 L120 178 L111 129 L62 120 L111 111 Z" fill="#EFF6FF"></path>
        </svg>
      </div>

      <p class="eyebrow">Error 404</p>
      <h1 id="lost-title" class="lost-title">This page drifted <span class="grad-text">out of orbit.</span></h1>
      <p class="lost-lead">
        The address does not match anything on this site. It may have moved, or the link may have a typo. The home page and the project list are a short hop away.
      </p>

      <div class="lost-actions">
        <a class="btn btn-primary" href={withBase('')}>
          Back to the home page
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="btn" href={withBase('projects/')}>
          See the projects
          <Icon name="grid" size={18} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    position: relative;
    display: grid;
    place-items: center;
    min-height: calc(100vh - var(--nav-h));
    min-height: calc(100svh - var(--nav-h));
    padding: calc(var(--nav-h) + 1.5rem) 0 4rem;
    text-align: center;
  }
  .lost-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 40rem;
  }
  .orbit {
    width: min(240px, 62vw);
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 0 28px rgb(59 130 246 / 0.25));
    animation: lost-float 7s ease-in-out infinite alternate;
  }
  .orbit svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .lost-title {
    margin-top: 0.6rem;
    font-size: clamp(2rem, 6vw, 3.4rem);
    font-weight: 600;
  }
  .lost-lead {
    margin-top: 1.1rem;
    max-width: 52ch;
    color: var(--muted);
  }
  .lost-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  .lost-actions .btn {
    min-height: 44px;
    justify-content: center;
  }
  @keyframes lost-float {
    to {
      transform: translateY(-8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit {
      animation: none;
    }
  }
</style>
