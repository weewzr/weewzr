---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Page not found" description="The page you asked for does not exist on this site." noindex>
  <section class="lost" aria-labelledby="lost-title">
    <div class="container lost-inner">
      <p class="eyebrow">Error 404</p>
      <h1 id="lost-title" class="lost-title">This page drifted out of orbit.</h1>
      <p class="lost-lead">
        The address does not match anything on this site. It may have moved, or the link may have a typo. The home page and the project list are a short hop away.
      </p>

      <div class="lost-actions">
        <a class="btn btn-primary" href={withBase('')}>
          Back to the home page
          <Icon name="arrow-right" size={20} />
        </a>
        <a class="btn" href={withBase('projects/')}>
          See the projects
          <Icon name="grid" size={20} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    padding-block: var(--space-8);
  }
  .lost-inner {
    max-width: 40rem;
    margin-inline: 0;
  }
  .lost-title {
    margin-top: var(--space-1);
    font-size: var(--fs-page-title);
  }
  .lost-lead {
    margin-top: var(--space-4);
    max-width: 52ch;
    font-size: var(--fs-lead);
    color: var(--text-muted);
  }
  .lost-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .lost-actions .btn {
    min-height: 44px;
  }
</style>
