---
/**
 * Home: one factual statement with the Perry mascot and his hover speech bubble beside it (the owner's choice;
 * see PerryHero.astro), the four project rows
 * (figure and one checked result each) and the contact strip. Every word and number comes from src/data/site.ts
 * and the content collections.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import PerryHero from '../components/PerryHero.astro';
import Contact from '../components/Contact.astro';
import { site, social, education } from '../data/site';
import { withBase } from '../lib/url';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  description: site.description,
  sameAs: [social.github, social.linkedin],
  affiliation: { '@type': 'CollegeOrUniversity', name: education.institution },
};
---

<BaseLayout path="" jsonLd={personLd}>
  <section class="intro" aria-labelledby="intro-title">
    <div class="container intro__grid">
      <div class="intro__copy">
        <p class="intro__name">{site.name}</p>
        <h1 id="intro-title" class="intro__statement">{site.statement}</h1>
        <p class="intro__links">
          <a href={withBase('about/')}>About me</a>
          <a href={withBase('writing/')}>Writing</a>
          <a href={social.github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in a new tab)</span></a>
          <a href={social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
        </p>
      </div>
      <PerryHero />
    </div>
  </section>

  <FeaturedProjects showHead id="projects" />
  <Contact variant="strip" />
</BaseLayout>

<style>
  .intro {
    padding-block: var(--space-5) 0;
  }
  /* Statement on the left, Perry on the right. Perry is sized to the height the statement already takes, so the
     first project row stays above the fold of a 1440 x 900 window. On narrow screens Perry sits under the links. */
  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-5);
  }
  /* Perry's width (clamp(150px, 17vw, 240px), 132 px below 720 px) and his bubble live in PerryHero.astro. */
  @media (max-width: 719px) {
    .intro__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
  .intro__name {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--text);
  }
  /* The statement already names the degree, the university and the research involvement, so no separate meta
     line repeats them. The measure is wide enough to keep the sentence to four lines at 1440 px, so the first
     project row (figure and checked result) stays above the fold of a 1440 x 900 window. */
  .intro__statement {
    margin-top: var(--space-3);
    max-width: 42ch;
    font-size: var(--fs-statement);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin-top: var(--space-3);
  }
  .intro__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    font-weight: 600;
    font-size: 0.9375rem;
  }
</style>

<script>
  // Links made before the site had separate pages: #about, #skills and #interests now live on the About page.
  const moved: Record<string, string> = { '#about': 'about/', '#skills': 'about/#skills', '#interests': 'about/#interests' };
  const target = moved[window.location.hash];
  if (target) {
    const base = document.querySelector<HTMLAnchorElement>('a.nav__brand')?.getAttribute('href') ?? '/';
    window.location.replace(base.replace(/\/?$/, '/') + target);
  }
</script>
