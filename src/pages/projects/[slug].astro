---
/**
 * Static case-study pages, one per project in src/data/site.ts.
 * The long-form body comes from src/content/projects/<slug>.mdx when that file exists.
 * Without an entry the page is still built from the data file, so the build never fails.
 */
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ScrollTable from '../../components/ScrollTable.astro';
import Figure from '../../components/case/Figure.astro';
import Roadmap from '../../components/case/Roadmap.astro';
import SourceList from '../../components/case/SourceList.astro';
import CaseProseStyles from '../../components/case/CaseProseStyles.astro';
import { projects, caseStudyTabs, caseStudyPinned } from '../../data/site';
import type { Project } from '../../data/site';
import { withBase } from '../../lib/url';
// Classic script text, inlined after the content so the tabs form before the first paint.
import caseTabsScript from '../../scripts/case-tabs.js?raw';

interface Props {
  project: Project;
  entry: CollectionEntry<'projects'> | null;
  prev: Project | null;
  next: Project | null;
}

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  const byId = new Map(entries.map((e) => [e.id, e]));
  const n = projects.length;
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      entry: byId.get(project.slug) ?? null,
      // Cyclic navigation; two projects would point both ways at the same page, so only "next" is shown.
      prev: n > 2 ? projects[(i - 1 + n) % n] : null,
      next: n > 1 ? projects[(i + 1) % n] : null,
    },
  }));
}

const { project, entry, prev, next } = Astro.props;
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content ?? null;

// A tab exists when at least one of its section headings is in the rendered MDX. The bar is rendered here,
// hidden, and src/scripts/case-tabs.js groups the sections and reveals it. Fewer than two tabs: no bar.
const h2Texts = new Set((rendered?.headings ?? []).filter((h) => h.depth === 2).map((h) => h.text.trim()));
const pinnedTexts = new Set<string>(caseStudyPinned);
const activeTabs = caseStudyTabs.filter((tab) => tab.headings.some((h) => h2Texts.has(h) && !pinnedTexts.has(h)));
const tabConfig = JSON.stringify({ tabs: caseStudyTabs, pinned: caseStudyPinned });

const title = entry?.data.title ?? `${project.name} case study`;
const summary = entry?.data.summary ?? project.description;
const path = `projects/${project.slug}/`;

const planned = project.stage === 'planned';
// A project without a real screenshot (image is null) gets a neutral panel instead of an image.
const full = project.image ? withBase(project.image) : null;
const small = project.image?.endsWith('.webp') ? withBase(project.image.replace(/\.webp$/, '-640.webp')) : null;
const srcset = full && small ? `${small} 640w, ${full} 1280w` : undefined;

const statusNote = entry?.data.statusNote;
const roadmap = entry?.data.roadmap ?? [];
const figures = entry?.data.figures ?? [];
const hasStatus = Boolean(statusNote) || roadmap.length > 0;

// Fallback source list so a page without an MDX entry still points at its repository (when it has one).
const sources: { label: string; url: string }[] = entry?.data.sources?.length
  ? entry.data.sources
  : project.repoUrl
    ? [{ label: `${project.name} repository on GitHub`, url: project.repoUrl }]
    : [];
---

<BaseLayout title={title} description={summary} path={path} type="article">
  <article class="case" aria-labelledby="case-title">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href={withBase('')}>Home</a></li>
          <li><a href={withBase('projects/')}>Projects</a></li>
          <li aria-current="page">{project.name}</li>
        </ol>
      </nav>

      <header class="case-head">
        <div class="head-text">
          <p class="status">{project.status}</p>
          <h1 id="case-title" class="grad-text">{project.name}</h1>
          <p class="tagline">{project.tagline}</p>
          {entry && <p class="summary">{summary}</p>}

          <ul class="tech" aria-label={`${project.name} technologies`}>
            {project.tech.map((t) => <li class="chip">{t}</li>)}
          </ul>

          <div class="actions">
            {
              project.siteUrl && (
                <a
                  class="btn btn-primary"
                  href={project.siteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Visit Website for ${project.name} (opens in a new tab)`}
                >
                  Visit Website
                  <Icon name="external" size={18} />
                </a>
              )
            }
            {
              project.repoUrl && (
                <a
                  class="btn"
                  href={project.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View GitHub Repository for ${project.name} (opens in a new tab)`}
                >
                  <Icon name="github" size={18} />
                  View GitHub Repository
                </a>
              )
            }
            {
              !project.siteUrl && project.comingSoon && (
                <span class="soon-label">Website Coming Soon</span>
              )
            }
          </div>
          {planned && (
            <p class="planned-note" role="note">
              <strong>Planned:</strong> no code or repository yet.
            </p>
          )}
        </div>

        <figure class="head-media">
          {
            full ? (
              <div class="frame">
                <img
                  src={full}
                  srcset={srcset}
                  sizes="(min-width: 1180px) 560px, (min-width: 900px) 46vw, 100vw"
                  width="1280"
                  height="800"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  alt={project.imageAlt}
                />
              </div>
            ) : (
              <div class="frame frame-empty">
                <p>
                  <span class="frame-empty-label">{planned ? 'Planned' : 'No image yet'}</span>
                  {planned ? 'There is no interface or code to show yet.' : 'No screenshot is available yet.'}
                </p>
              </div>
            )
          }
          {project.imageCaption && <figcaption>{project.imageCaption}</figcaption>}
        </figure>
      </header>

      <div class="case-body glass" data-case-tabs={activeTabs.length > 1 ? '' : undefined} data-config={tabConfig}>
        {
          activeTabs.length > 1 && (
            <div class="case-tabs-bar" data-case-tabs-bar>
              {activeTabs.map((tab) => (
                <button type="button" id={`tab-btn-${tab.id}`} data-tab={tab.id} aria-controls={`tab-${tab.id}`}>
                  {tab.label}
                </button>
              ))}
            </div>
          )
        }
        <div class="case-prose">
          {
            Content ? (
              <Content components={{ table: ScrollTable }} />
            ) : (
              <>
                <h2>About this project</h2>
                <p>{project.description}</p>
                <h2>Main features</h2>
                <ul>
                  {project.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </>
            )
          }
        </div>
        {activeTabs.length > 1 && <script is:inline set:html={caseTabsScript} />}
      </div>

      {
        hasStatus && (
          <section class="extra glass" aria-labelledby="status-title">
            <h2 id="status-title">Development status and roadmap</h2>
            <Roadmap items={roadmap} statusNote={statusNote} label="Development roadmap" />
          </section>
        )
      }

      {
        figures.length > 0 && (
          <section class="extra glass" aria-labelledby="figures-title">
            <h2 id="figures-title">Screenshots and diagrams</h2>
            {figures.map((f) => (
              <Figure src={f.src} alt={f.alt} caption={f.caption} width={f.width} height={f.height} zoom />
            ))}
          </section>
        )
      }

      <div class="sources-wrap">
        <SourceList sources={sources} />
      </div>

      {
        (prev || next) && (
          <nav class={`pager ${prev && next ? 'two' : ''}`} aria-label="Other projects">
            {prev && (
              <a class="pager-link glass gradient-border" href={withBase(`projects/${prev.slug}/`)} rel="prev">
                <span class="pager-dir">
                  <Icon name="arrow-right" size={16} class="flip" /> Previous project
                </span>
                <span class="pager-name">{prev.name}</span>
              </a>
            )}
            {next && (
              <a class="pager-link next glass gradient-border" href={withBase(`projects/${next.slug}/`)} rel="next">
                <span class="pager-dir">
                  Next project <Icon name="arrow-right" size={16} />
                </span>
                <span class="pager-name">{next.name}</span>
              </a>
            )}
          </nav>
        )
      }
    </div>
  </article>
  <CaseProseStyles />
</BaseLayout>

<style>
  .case {
    padding-top: calc(var(--nav-h) + clamp(1.25rem, 4vw, 2.5rem));
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  /* Breadcrumb */
  .crumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .crumbs li {
    display: flex;
    align-items: center;
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: rgb(148 163 184 / 0.55);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #c4b5fd;
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .crumbs [aria-current='page'] {
    padding-block: 0.4rem;
    color: var(--text);
  }

  /* Header */
  .case-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    margin-top: 1.25rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .case-head {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }
  .head-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    margin: 0;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: #ddd6fe;
    background: rgb(124 58 237 / 0.16);
    border: 1px solid rgb(167 139 250 / 0.38);
  }
  .status::before {
    content: '';
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--lavender);
    box-shadow: 0 0 8px var(--lavender);
  }
  h1 {
    margin-top: 0.9rem;
    font-size: clamp(2.4rem, 6vw, 3.75rem);
    font-weight: 700;
    padding-bottom: 0.08em;
  }
  .tagline {
    margin-top: 0.6rem;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.45;
    color: var(--lavender);
  }
  .summary {
    margin-top: 1rem;
    max-width: 60ch;
    color: #cbd5e1;
  }
  .tech {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }
  .actions .btn {
    min-height: 44px;
  }
  .soon-label {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--muted);
    border: 1px dashed rgb(148 163 184 / 0.4);
  }
  .head-media {
    margin: 0;
    min-width: 0;
  }
  .frame {
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgb(148 163 184 / 0.25);
    background: var(--bg-2);
    aspect-ratio: 16 / 10;
    box-shadow:
      0 24px 56px -28px rgb(0 0 0 / 0.9),
      0 0 50px rgb(124 58 237 / 0.16);
  }
  .frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .head-media figcaption {
    margin-top: 0.6rem;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--muted);
    text-align: center;
  }

  /* Body panel */
  .case-body {
    max-width: 52rem;
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    padding: clamp(1.25rem, 3.5vw, 2.5rem);
    background: var(--glass-strong);
  }

  /* Status, roadmap, figures and sources panels */
  .extra {
    max-width: 52rem;
    margin: 1.75rem auto 0;
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3.5vw, 2.5rem);
    background: var(--glass-strong);
  }
  .extra h2 {
    margin-bottom: 1rem;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .sources-wrap {
    max-width: 52rem;
    margin: 1.75rem auto 0;
  }
  .planned-note {
    margin-top: 1.1rem;
    padding: 0.7rem 1rem;
    border: 1px dashed rgb(167 139 250 / 0.5);
    border-radius: 12px;
    background: rgb(124 58 237 / 0.1);
    color: #e2e8f0;
    font-size: 0.95rem;
  }
  .planned-note strong {
    color: #fff;
  }
  .frame-empty {
    display: grid;
    place-items: center;
    padding: 1.5rem;
    border-style: dashed;
    text-align: center;
    background: rgb(11 27 58 / 0.5);
  }
  .frame-empty p {
    display: grid;
    gap: 0.4rem;
    color: #cbd5e1;
  }
  .frame-empty-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lavender);
  }

  /* Previous / next */
  .pager {
    max-width: 52rem;
    margin: 1.75rem auto 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .pager.two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 44px;
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: var(--text);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .pager-link.next {
    text-align: right;
    align-items: flex-end;
  }
  .pager-link:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 36px rgb(124 58 237 / 0.28);
  }
  .pager-dir {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pager-dir :global(.flip) {
    transform: scaleX(-1);
  }
  .pager-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.35rem;
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .pager-link:hover {
      transform: none;
    }
  }
</style>

<style is:global>
  /* Case-study tabs (see src/scripts/case-tabs.js). Without the script the bar stays hidden and every
     section is shown in authored order. The script sets data-ready on .case-body once the tabs exist. */
  .case-tabs-bar {
    display: none;
  }
  [data-case-tabs][data-ready] .case-tabs-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 1.75rem;
    padding: 0.3rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgb(6 11 27 / 0.55);
  }
  .case-tabs-bar button {
    flex: 1 1 auto;
    min-height: 44px;
    padding: 0.4rem 1rem;
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: #cbd5e1;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .case-tabs-bar button:hover {
    background: rgb(148 163 184 / 0.14);
    color: #fff;
  }
  .case-tabs-bar button[aria-selected='true'] {
    color: #fff;
    background: rgb(124 58 237 / 0.3);
    border-color: rgb(167 139 250 / 0.55);
  }
  .case-tab-panel {
  }
  .case-tab-panel > :first-child {
    margin-top: 0;
  }
  @media print {
    .case-tabs-bar {
      display: none !important;
    }
    /* Hidden panels are shown for printing by the beforeprint handler in case-tabs.js: the preflight
       [hidden] rule is important and layered, so a CSS override here would lose. */
    .case-tab-panel + .case-tab-panel {
      margin-top: 2.6rem;
    }
  }
  @media (max-width: 640px) {
    .case-prose {
      font-size: 1rem;
    }
    .case-prose table {
      font-size: 0.86rem;
    }
  }
</style>
