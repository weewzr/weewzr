---
/**
 * Static case-study pages, one per project in src/data/site.ts.
 * The long-form body comes from src/content/projects/<slug>.mdx when that file exists.
 * Without an entry the page is still built from the data file, so the build never fails.
 */
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ScrollTable from '../../components/ScrollTable.astro';
import Figure from '../../components/case/Figure.astro';
import Roadmap from '../../components/case/Roadmap.astro';
import PhaseRoadmap from '../../components/case/PhaseRoadmap.astro';
import SourceList from '../../components/case/SourceList.astro';
import CaseProseStyles from '../../components/case/CaseProseStyles.astro';
import { projects, caseStudyTabs, caseStudyPinned, site } from '../../data/site';
import type { Project } from '../../data/site';
import { withBase } from '../../lib/url';
// Classic script text, inlined after the content so the tabs form before the first paint.
import caseTabsScript from '../../scripts/case-tabs.js?raw';

interface Props {
  project: Project;
  entry: CollectionEntry<'projects'> | null;
  prev: Project | null;
  next: Project | null;
}

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  const byId = new Map(entries.map((e) => [e.id, e]));
  const n = projects.length;
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      entry: byId.get(project.slug) ?? null,
      // Cyclic navigation; two projects would point both ways at the same page, so only "next" is shown.
      prev: n > 2 ? projects[(i - 1 + n) % n] : null,
      next: n > 1 ? projects[(i + 1) % n] : null,
    },
  }));
}

const { project, entry, prev, next } = Astro.props;
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content ?? null;

// A tab exists when at least one of its section headings is in the rendered MDX. The bar is rendered here,
// hidden, and src/scripts/case-tabs.js groups the sections and reveals it. Fewer than two tabs: no bar.
const h2Texts = new Set((rendered?.headings ?? []).filter((h) => h.depth === 2).map((h) => h.text.trim()));
const pinnedTexts = new Set<string>(caseStudyPinned);
const activeTabs = caseStudyTabs.filter((tab) => tab.headings.some((h) => h2Texts.has(h) && !pinnedTexts.has(h)));
const tabConfig = JSON.stringify({ tabs: caseStudyTabs, pinned: caseStudyPinned });

const title = entry?.data.title ?? `${project.name} case study`;
const summary = entry?.data.summary ?? project.description;
const path = `projects/${project.slug}/`;

const planned = project.stage === 'planned';
// A project without a real screenshot (image is null) gets a neutral panel instead of an image.
const full = project.image ? withBase(project.image) : null;
const small = project.image?.endsWith('.webp') ? withBase(project.image.replace(/\.webp$/, '-640.webp')) : null;
const srcset = full && small ? `${small} 640w, ${full} 1280w` : undefined;

const statusNote = entry?.data.statusNote;
const roadmap = entry?.data.roadmap ?? [];
// A phase-based roadmap (milestone cards, no dates) replaces the dated timeline when the entry has one.
const phases = entry?.data.phases ?? [];
const figures = entry?.data.figures ?? [];
const hasStatus = Boolean(statusNote) || roadmap.length > 0 || phases.length > 0;

// Fallback source list so a page without an MDX entry still points at its repository (when it has one).
const sources: { label: string; url: string }[] = entry?.data.sources?.length
  ? entry.data.sources
  : project.repoUrl
    ? [{ label: `${project.name} repository on GitHub`, url: project.repoUrl }]
    : [];
// Structured data. A planned project has no code, so it is described as a plain creative work.
const languages = project.tech.filter((t) => ['Rust', 'Python', 'JavaScript'].includes(t));
const projectLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': project.repoUrl ? 'SoftwareSourceCode' : 'CreativeWork',
  name: project.name,
  headline: title,
  description: project.description,
  url: new URL(path, site.url).href,
  author: { '@type': 'Person', name: site.name, url: site.url },
  ...(project.repoUrl ? { codeRepository: project.repoUrl } : {}),
  ...(languages.length ? { programmingLanguage: languages } : {}),
};
---

<BaseLayout
  title={title}
  description={summary}
  path={path}
  type="article"
  breadcrumbs={[
    { label: 'Home', path: '' },
    { label: 'Projects', path: 'projects/' },
    { label: project.name, path },
  ]}
  jsonLd={projectLd}
>
  <article class="case" aria-labelledby="case-title">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href={withBase('')}>Home</a></li>
          <li><a href={withBase('projects/')}>Projects</a></li>
          <li aria-current="page">{project.name}</li>
        </ol>
      </nav>

      <header class="case-head">
        <div class="head-text">
          <p class="status">{project.status}</p>
          <h1 id="case-title">{project.name}</h1>
          <p class="tagline">{project.tagline}</p>
          {entry && <p class="summary">{summary}</p>}

          <ul class="tech" aria-label={`${project.name} technologies`}>
            {project.tech.map((t) => <li class="chip">{t}</li>)}
          </ul>

          <div class="actions">
            {
              project.siteUrl && (
                <a
                  class="btn btn-primary"
                  href={project.siteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Live site of ${project.name} (opens in a new tab)`}
                >
                  Live site
                  <Icon name="external" size={18} />
                </a>
              )
            }
            {
              project.repoUrl && (
                <a
                  class="btn"
                  href={project.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Code of ${project.name} on GitHub (opens in a new tab)`}
                >
                  <Icon name="github" size={18} />
                  Code on GitHub
                </a>
              )
            }
            {
              !project.siteUrl && project.comingSoon && (
                <span class="soon-label">Website coming soon</span>
              )
            }
          </div>
          {planned && (
            <p class="planned-note" role="note">
              <strong>Planned:</strong> no code or repository yet.
            </p>
          )}
        </div>

        <figure class="head-media">
          {
            full ? (
              <div class="frame">
                <img
                  src={full}
                  srcset={srcset}
                  sizes="(min-width: 1180px) 560px, (min-width: 900px) 46vw, 100vw"
                  width="1280"
                  height="800"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  alt={project.imageAlt}
                />
              </div>
            ) : (
              <div class="frame frame-empty">
                <p>
                  <span class="frame-empty-label">{planned ? 'Planned' : 'No image yet'}</span>
                  {planned ? 'There is no interface or code to show yet.' : 'No screenshot is available yet.'}
                </p>
              </div>
            )
          }
          {project.imageCaption && <figcaption>{project.imageCaption}</figcaption>}
        </figure>
      </header>

      <div class="case-body glass" data-case-tabs={activeTabs.length > 1 ? '' : undefined} data-config={tabConfig}>
        {
          activeTabs.length > 1 && (
            <div class="case-tabs-bar" data-case-tabs-bar>
              {activeTabs.map((tab) => (
                <button type="button" id={`tab-btn-${tab.id}`} data-tab={tab.id} aria-controls={`tab-${tab.id}`}>
                  {tab.label}
                </button>
              ))}
            </div>
          )
        }
        <div class="case-prose">
          {
            Content ? (
              <Content components={{ table: ScrollTable }} />
            ) : (
              <>
                <h2>About this project</h2>
                <p>{project.description}</p>
                <h2>Main features</h2>
                <ul>
                  {project.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </>
            )
          }
        </div>
        {activeTabs.length > 1 && <script is:inline set:html={caseTabsScript} />}
      </div>

      {
        hasStatus && (
          <section class="extra glass" aria-labelledby="status-title">
            <h2 id="status-title">Development status and roadmap</h2>
            {phases.length > 0 ? (
              <PhaseRoadmap phases={phases} statusNote={statusNote} label="Development roadmap" />
            ) : (
              <Roadmap items={roadmap} statusNote={statusNote} label="Development roadmap" />
            )}
          </section>
        )
      }

      {
        figures.length > 0 && (
          <section class="extra glass" aria-labelledby="figures-title">
            <h2 id="figures-title">Screenshots and diagrams</h2>
            {figures.map((f) => (
              <Figure src={f.src} alt={f.alt} caption={f.caption} width={f.width} height={f.height} zoom />
            ))}
          </section>
        )
      }

      <div class="sources-wrap">
        <SourceList sources={sources} />
      </div>

      {
        (prev || next) && (
          <nav class={`pager ${prev && next ? 'two' : ''}`} aria-label="Other projects">
            {prev && (
              <a class="pager-link glass" href={withBase(`projects/${prev.slug}/`)} rel="prev">
                <span class="pager-dir">
                  <Icon name="arrow-right" size={16} class="flip" /> Previous project
                </span>
                <span class="pager-name">{prev.name}</span>
              </a>
            )}
            {next && (
              <a class="pager-link next glass" href={withBase(`projects/${next.slug}/`)} rel="next">
                <span class="pager-dir">
                  Next project <Icon name="arrow-right" size={16} />
                </span>
                <span class="pager-name">{next.name}</span>
              </a>
            )}
          </nav>
        )
      }
    </div>
  </article>
  <CaseProseStyles />
</BaseLayout>

<style>
  .case {
    padding-top: var(--space-5);
    padding-bottom: var(--space-8);
  }

  /* Breadcrumb */
  .crumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .crumbs li {
    display: flex;
    align-items: center;
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: var(--space-2);
    color: var(--border-strong);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }
  .crumbs [aria-current='page'] {
    padding-block: var(--space-2);
    color: var(--text);
  }

  /* Header */
  .case-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-4);
    align-items: start;
  }
  @media (min-width: 900px) {
    .case-head {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: var(--space-7);
    }
  }
  .head-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 100%;
    margin: 0;
    font-size: var(--fs-label);
    font-weight: 500;
    line-height: 1.4;
    color: var(--text);
  }
  .status::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  h1 {
    margin-top: var(--space-3);
    font-size: var(--fs-page-title);
    color: var(--text);
  }
  .tagline {
    margin-top: var(--space-2);
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--text-muted);
  }
  .summary {
    margin-top: var(--space-4);
    max-width: 68ch;
    color: var(--text);
  }
  .tech {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .actions .btn {
    min-height: 44px;
  }
  .soon-label {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .head-media {
    margin: 0;
    min-width: 0;
  }
  /* The image keeps the ratio given by its width and height attributes, so nothing moves when it loads. */
  .frame {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-subtle);
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .head-media figcaption {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--text-muted);
    text-align: center;
  }

  /* Body: the prose sits directly on the page. */
  .case-body {
    max-width: 48rem;
    margin: var(--space-7) auto 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
  }

  /* Status, roadmap, figures and sources panels */
  .extra {
    max-width: 48rem;
    margin: var(--space-6) auto 0;
    padding: var(--space-5);
    background: var(--surface);
  }
  .extra h2 {
    margin-bottom: var(--space-4);
    font-size: var(--fs-card-title);
    font-weight: 600;
  }
  .sources-wrap {
    max-width: 48rem;
    margin: var(--space-6) auto 0;
  }
  .planned-note {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-size: var(--fs-small);
  }
  .frame-empty {
    display: grid;
    place-items: center;
    padding: var(--space-5);
    aspect-ratio: 16 / 10;
    border-style: dashed;
    text-align: center;
    background: var(--bg-subtle);
  }
  .frame-empty p {
    display: grid;
    gap: var(--space-2);
    color: var(--text-muted);
  }
  .frame-empty-label {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--text);
  }

  /* Previous / next */
  .pager {
    max-width: 48rem;
    margin: var(--space-6) auto 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .pager.two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: 44px;
    padding: var(--space-4);
    text-decoration: none;
    color: var(--text);
    transition: border-color var(--ease);
  }
  .pager-link.next {
    text-align: right;
    align-items: flex-end;
  }
  .pager-link:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }
  .pager-dir {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .pager-dir :global(.flip) {
    transform: scaleX(-1);
  }
  .pager-name {
    font-weight: 600;
    font-size: var(--fs-card-title);
    color: var(--text);
  }
</style>

<style is:global>
  /* Case-study tabs (see src/scripts/case-tabs.js). Without the script the bar stays hidden and every
     section is shown in authored order. The script sets data-ready on .case-body once the tabs exist.
     With JavaScript on, the bar's space is reserved from the first paint (visibility: hidden) so that
     the page does not shift when the script reveals it. */
  .case-tabs-bar {
    display: none;
  }
  .js [data-case-tabs]:not([data-ready]) .case-tabs-bar {
    display: flex;
    min-height: 45px;
    margin: 0 0 var(--space-5);
    visibility: hidden;
  }
  [data-case-tabs][data-ready] .case-tabs-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    margin: 0 0 var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .case-tabs-bar button {
    flex: none;
    min-height: 44px;
    margin-bottom: -1px;
    padding: var(--space-2) var(--space-1);
    border: 0;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition:
      color var(--ease),
      border-color var(--ease);
  }
  .case-tabs-bar button:hover {
    color: var(--text);
  }
  .case-tabs-bar button[aria-selected='true'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .case-tab-panel > :first-child {
    margin-top: 0;
  }
  @media print {
    .case-tabs-bar {
      display: none !important;
    }
    /* Hidden panels are shown for printing by the beforeprint handler in case-tabs.js: the preflight
       [hidden] rule is important and layered, so a CSS override here would lose. */
    .case-tab-panel + .case-tab-panel {
      margin-top: var(--space-7);
    }
  }
  @media (max-width: 640px) {
    .case-prose table {
      font-size: var(--fs-label);
    }
  }
</style>
