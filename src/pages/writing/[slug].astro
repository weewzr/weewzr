---
/**
 * One research note. Entries come from src/content/notes/*.md; the slug is the file name.
 * Drafts are not built. The body is rendered Markdown inside a scoped typography wrapper.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { withBase } from '../../lib/url';
import { wrapTables } from '../../lib/tables';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { title, description, category, kind, date, sourceUrl, sourceLabel, tags } = note.data;
const { Content } = await render(note);

// Wrap each table in a labelled, keyboard-focusable scroll region so wide tables scroll on phones.
const html = note.rendered?.html ? wrapTables(note.rendered.html) : null;

const iso = date.toISOString().slice(0, 10);
const shown = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(date);
const categoryLabel = category.charAt(0) + category.slice(1).toLowerCase();
const categorySlug = category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const path = `writing/${note.id}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: iso,
  inLanguage: 'en',
  articleSection: category,
  keywords: tags.join(', '),
  author: { '@type': 'Person', name: site.name, url: site.url },
  mainEntityOfPage: new URL(path, site.url).href,
  ...(sourceUrl ? { isBasedOn: sourceUrl } : {}),
};
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<BaseLayout title={title} description={description} path={path} type="article">
  <script is:inline type="application/ld+json" set:html={jsonLdText} />

  <article class="note">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={withBase('')}>Home</a></li>
        <li><a href={withBase('writing/')}>Writing</a></li>
        <li aria-current="page">{categoryLabel}</li>
      </ol>
    </nav>

    <header class="note-head">
      <p class="eyebrow">{kind}</p>
      <h1>{title}</h1>
      <p class="note-lead">{description}</p>

      <dl class="meta" aria-label="Note details">
        <div>
          <dt>Category</dt>
          <dd><a href={withBase(`writing/#cat-${categorySlug}`)}>{categoryLabel}</a></dd>
        </div>
        <div>
          <dt>Type</dt>
          <dd>{kind}</dd>
        </div>
        <div>
          <dt>Published</dt>
          <dd><time datetime={iso}>{shown}</time></dd>
        </div>
        {
          tags.length > 0 && (
            <div class="meta-tags">
              <dt>Tags</dt>
              <dd>
                <ul>
                  {tags.map((tag) => (
                    <li class="chip">{tag}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    <div class="prose">
      {html ? <Fragment set:html={html} /> : <Content />}
    </div>

    {
      sourceUrl && (
        <aside class="source glass" aria-labelledby="source-title">
          <p class="eyebrow" id="source-title">Source document</p>
          <p class="source-label">{sourceLabel ?? sourceUrl}</p>
          <p class="source-url">{sourceUrl.replace(/^https?:\/\//, '')}</p>
          <a class="btn" href={sourceUrl} target="_blank" rel="noopener noreferrer">
            Open the source
            <span class="sr-only"> (opens in a new tab)</span>
            <Icon name="external" size={18} />
          </a>
        </aside>
      )
    }

    <nav class="back" aria-label="More notes">
      <a href={withBase('writing/')}>
        <Icon name="arrow-right" size={18} class="flip" />
        All writing
      </a>
      <a href={withBase('')}>Home</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .note {
    width: min(100% - 2rem, 50rem);
    margin-inline: auto;
    padding-block: var(--space-6) var(--space-8);
  }

  /* Breadcrumb. */
  .crumbs {
    margin-bottom: var(--space-4);
    font-size: var(--fs-small);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--text-muted);
  }
  .crumbs li:not(:last-child)::after {
    content: '/';
    margin-left: var(--space-3);
    color: var(--border-strong);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* Header and meta row. */
  .note-head h1 {
    margin-top: var(--space-2);
    font-size: var(--fs-page-title);
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .note-lead {
    margin-top: var(--space-4);
    max-width: 68ch;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--text-muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    margin: var(--space-5) 0 0;
    padding: var(--space-4) 0;
    border-block: 1px solid var(--border);
  }
  .meta > div {
    min-width: 0;
  }
  .meta dt {
    font-size: var(--fs-label);
    color: var(--text-muted);
  }
  .meta dd {
    display: flex;
    align-items: center;
    min-height: 44px;
    margin: 0;
    font-size: var(--fs-body);
  }
  .meta-tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Typography for the rendered Markdown. Selectors use :global because the content is injected. */
  .prose {
    max-width: 68ch;
    margin-top: var(--space-6);
    font-size: var(--fs-body);
    line-height: 1.68;
    color: var(--text);
    overflow-wrap: break-word;
  }
  .prose > :global(* + *) {
    margin-top: var(--space-4);
  }
  .prose :global(h2) {
    margin-top: var(--space-7);
    font-family: var(--font-display);
    font-size: var(--fs-section-title);
    font-weight: 500;
    scroll-margin-top: calc(var(--nav-h) + 12px);
  }
  .prose :global(h3) {
    margin-top: var(--space-6);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .prose :global(h2 + *) {
    margin-top: var(--space-4);
  }
  .prose :global(h3 + *) {
    margin-top: var(--space-3);
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    color: var(--accent-hover);
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-5);
  }
  .prose :global(li + li) {
    margin-top: var(--space-2);
  }
  .prose :global(li::marker) {
    color: var(--text-muted);
  }
  .prose :global(sup),
  .prose :global(sub) {
    font-size: 0.72em;
    line-height: 0;
  }
  .prose :global(blockquote) {
    margin-inline: 0;
    padding: var(--space-1) 0 var(--space-1) var(--space-4);
    border-left: 3px solid var(--accent);
    color: var(--text-muted);
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin-block: var(--space-6);
  }
  .prose :global(code) {
    padding: 0.08em 0.4em;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--bg-subtle);
    color: var(--text);
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }
  /* Astro highlights fenced code with a dark theme and inline colours; page tokens replace them. */
  .prose :global(pre) {
    overflow-x: auto;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--bg-subtle) !important;
    color: var(--text) !important;
    font-size: 0.9em;
    line-height: 1.6;
    -webkit-overflow-scrolling: touch;
  }
  .prose :global(pre span) {
    color: inherit !important;
  }
  .prose :global(pre code) {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: inherit;
    overflow-wrap: normal;
  }
  .prose :global(.table-scroll) {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .prose :global(table) {
    width: 100%;
    min-width: 22rem;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(thead th) {
    background: var(--bg-subtle);
    font-weight: 600;
  }

  /* Source block and back links. */
  .source {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    margin-top: var(--space-7);
    padding: var(--space-5);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .source-label {
    font-size: var(--fs-card-title);
    font-weight: 600;
  }
  .source-url {
    max-width: 100%;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }
  .source .btn {
    margin-top: var(--space-2);
  }
  .back {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin-top: var(--space-6);
  }
  .back a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-weight: 600;
  }
  .back :global(.flip) {
    transform: rotate(180deg);
  }
</style>
