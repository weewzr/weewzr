---
/**
 * Static case-study pages for the community section, one per non-draft entry in src/content/community.
 * The page body, header, timeline, galleries, documents, related links and sources come from CaseStudy.astro.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudy from '../../components/case/CaseStudy.astro';
import { sections } from '../../data/site';
import { caseJsonLd, neighbours, sortEntries } from '../../lib/case';

const section = sections.find((s) => s.id === 'community')!;

export async function getStaticPaths() {
  const entries = sortEntries(await getCollection('community', ({ data }) => !data.draft));
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, ...neighbours(entries, i) },
  }));
}

const { entry, prev, next } = Astro.props;
const path = `${section.path}${entry.id}/`;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  path={path}
  type="article"
  jsonLd={caseJsonLd(entry, section, path)}
>
  <CaseStudy entry={entry} section={section} prev={prev} next={next} />
</BaseLayout>
