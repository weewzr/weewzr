---
/**
 * Proof of concept page for the Astryx evaluation. Not linked from anywhere.
 * It mirrors the structure of a case-study page: BaseLayout, one container, four panels.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PocTabs from '../components/astryx/PocTabs.tsx';

const tabs = [
  { value: 'overview', label: 'Overview' },
  { value: 'methods', label: 'Methods' },
  { value: 'results', label: 'Results' },
  { value: 'verification', label: 'Verification' },
];
---

<BaseLayout title="Astryx proof of concept" description="Isolated test page." path="astryx-poc/" noindex>
  <section class="poc container">
    <h1>Astryx proof of concept</h1>
    <PocTabs client:visible tabs={tabs} />
    {
      tabs.map((t) => (
        <div id={`poc-panel-${t.value}`} role="tabpanel" aria-label={t.label}>
          <h2>{t.label}</h2>
          <p>Panel text for {t.label}. This is placeholder text for the measurement page only.</p>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .poc {
    padding-top: calc(var(--nav-h) + 2rem);
    padding-bottom: 4rem;
  }
</style>
